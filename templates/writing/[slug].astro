---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageTitle from "../../components/ui/PageTitle.astro";
import Section from "../../components/ui/Section.astro";
import Prose from "../../components/ui/Prose.astro";
import { absoluteUrl, personId } from "../../data/site";

export async function getStaticPaths() {
  const posts = await getCollection("writing");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const path = `/writing/${post.id}/`;
const formatDate = new Intl.DateTimeFormat("en", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" }).format(post.data.pubDate);
const postJsonLd = {
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  mainEntityOfPage: absoluteUrl(path),
  author: { "@id": personId },
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  jsonLd={postJsonLd}
  breadcrumbs={[{ name: "Writing", href: "/writing/" }, { name: post.data.title, href: path }]}
>
  <article>
    <PageTitle reading eyebrow={`Writing · ${formatDate}`} title={post.data.title}>{post.data.description}</PageTitle>
    <Section reading><Prose><Content /></Prose></Section>
  </article>
</BaseLayout>
