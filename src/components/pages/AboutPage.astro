---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Card from "../ui/Card.astro";
import InsetList from "../ui/InsetList.astro";
import PageTitle from "../ui/PageTitle.astro";
import Prose from "../ui/Prose.astro";
import Section from "../ui/Section.astro";
import { FULL_NAME, SITE_URL, personId, personImageId, websiteId } from "../../data/site";
import { about, alternatesFor, experience, paths, type Lang } from "../../data/profile";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = about[lang];
const url = `${SITE_URL}${paths[lang].about}`;
const aboutJsonLd = {
  "@type": ["AboutPage", "ProfilePage"],
  "@id": `${url}#webpage`,
  url,
  inLanguage: lang,
  name: lang === "es" ? `Sobre ${FULL_NAME} (alesanabriav)` : `About ${FULL_NAME} (alesanabriav)`,
  isPartOf: { "@id": websiteId },
  mainEntity: { "@id": personId },
  about: { "@id": personId },
  primaryImageOfPage: { "@id": personImageId },
};
---

<BaseLayout title={t.title} description={t.description} lang={lang} ogType="profile" jsonLd={aboutJsonLd} alternates={alternatesFor("about")}>
  <div class="about-header container">
    <img class="about-header__photo" src="/images/apple-park-portrait-600.webp" alt={FULL_NAME} width="120" height="120" fetchpriority="high" decoding="async" />
  </div>
  <PageTitle eyebrow={t.eyebrow} title={FULL_NAME}><Fragment set:html={t.lead} /></PageTitle>

  <Section title={t.background}>
    <p class="section-intro">{t.backgroundIntro}</p>
    <InsetList items={experience[lang]} />
  </Section>

  <Section>
    <figure class="about-photo">
      <img
        src="/images/wwdc26-1600.webp"
        srcset="/images/wwdc26-900.webp 900w, /images/wwdc26-1600.webp 1600w"
        sizes="(max-width: 800px) calc(100vw - 44px), 760px"
        alt={t.photoAlt}
        width="1600"
        height="1067"
        loading="lazy"
        decoding="async"
      />
      <figcaption>{t.photoCaption}</figcaption>
    </figure>
  </Section>

  <Section title={t.built} reading>
    <Prose><p set:html={t.builtText} /></Prose>
  </Section>

  <Section title={t.stack} reading>
    <Prose><p>{t.stackText}</p></Prose>
  </Section>

  <Section title={t.profilesTitle}>
    <Card>
      <ul class="plain-list">
        {t.profiles.map((profile) => <li><a class="text-link" href={profile.href} rel="me noopener noreferrer" target="_blank">{profile.label}</a></li>)}
      </ul>
    </Card>
  </Section>
</BaseLayout>
