---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Card from "../ui/Card.astro";
import PageTitle from "../ui/PageTitle.astro";
import Section from "../ui/Section.astro";
import { alternatesFor, paths, projects, projectsPage, type Lang } from "../../data/profile";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = projectsPage[lang];
const [cifro, ...tools] = projects[lang];
---

<BaseLayout title={t.title} description={t.description} lang={lang} alternates={alternatesFor("projects")} breadcrumbs={[{ name: t.crumb, href: paths[lang].projects }]}>
  <PageTitle eyebrow={t.eyebrow} title={t.heading}><Fragment set:html={t.lead} /></PageTitle>

  <Section title={t.app}>
    <Card title={cifro.title} meta={cifro.meta} icon={cifro.icon} links={cifro.links}><p>{cifro.text}</p></Card>
  </Section>

  <Section title={t.tools}>
    <div class="card-grid card-grid--3">
      {tools.map((tool) => (
        <Card title={tool.title} meta={tool.meta} glyph={tool.glyph} links={tool.links}><p>{tool.text}</p></Card>
      ))}
    </div>
  </Section>
</BaseLayout>
