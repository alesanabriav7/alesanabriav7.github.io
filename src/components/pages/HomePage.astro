---
import "../../styles/home-editorial.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { FULL_NAME, SITE_HANDLE, SITE_URL, personId, personImageId, profileLinks, websiteId } from "../../data/site";
import { contactEmail, home, paths, projects, ui, experience, alternatesFor, type Lang } from "../../data/profile";
import { formatPostDate, postPath, sortedPosts } from "../../data/posts";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = home[lang];
const s = ui[lang].sections;
const p = paths[lang];
const latestPosts = sortedPosts().slice(0, 3);
const [cifro, ...tools] = projects[lang];
const roles = experience[lang];
const photoAlt = lang === "es" ? "Retrato de Alejandro Sanabria Villescas" : "Portrait of Alejandro Sanabria Villescas";
const copy = lang === "es"
  ? { appStore: "Ver en App Store", writing: "Publicaciones", inSpanish: "En español", about: "Sobre mí", tools: "Las herramientas que uso para publicarla" }
  : { appStore: "View on the App Store", writing: "Writing", inSpanish: "In Spanish", about: "About me", tools: "The tools I use to ship it" };
const otherLanguage = alternatesFor("home").find((alternate) => alternate.hreflang === (lang === "es" ? "en" : "es"));

const profileJsonLd = {
  "@type": "ProfilePage",
  "@id": `${SITE_URL}${p.home}#webpage`,
  url: `${SITE_URL}${p.home}`,
  inLanguage: lang,
  name: `${FULL_NAME} (${SITE_HANDLE})`,
  isPartOf: { "@id": websiteId },
  mainEntity: { "@id": personId },
  about: { "@id": personId },
  primaryImageOfPage: { "@id": personImageId },
  description: t.description,
};
---

<BaseLayout title={t.title} description={t.description} lang={lang} ogType="profile" jsonLd={profileJsonLd} alternates={alternatesFor("home")} editorialHome>
  <div class="home-editorial">
    <header class="editorial-intro" id="about">
      <img
        class="editorial-intro__portrait"
        src="/alejandro-sanabria-villescas-192.jpg"
        alt={photoAlt}
        width="192"
        height="192"
        fetchpriority="high"
        decoding="async"
      />
      <div>
        <h1>{FULL_NAME}</h1>
        <p class="editorial-lead" set:html={t.lead} />
        {otherLanguage && <a class="editorial-language" href={otherLanguage.href} hreflang={otherLanguage.hreflang}>{lang === "es" ? "English" : "Español"}</a>}
      </div>
    </header>

    <nav class="editorial-index" aria-label={lang === "es" ? "Índice de esta página" : "On this page"}>
      <a class="editorial-link" href="#work">{lang === "es" ? "Experiencia" : "Experience"}</a><span aria-hidden="true"> · </span>
      <a class="editorial-link" href="#projects">{lang === "es" ? "Proyectos" : "Projects"}</a><span aria-hidden="true"> · </span>
      <a class="editorial-link" href="#blog">{copy.writing}</a>
    </nav>

    <section class="editorial-section" id="work" aria-label={lang === "es" ? "Experiencia profesional" : "Professional experience"}>
      <p class="editorial-history">{lang === "es" ? "Trabajo en tecnología desde 2012. Empecé en frontend y después construí y lideré productos web y móviles, con iOS y Android nativos en el centro de mi trabajo." : "I’ve worked in technology since 2012. I started in frontend, then built and led web and mobile products, with native iOS and Android at the core of my work."}</p>
      {roles.map((role, index) => (
        <article class="editorial-story">
          <h2>{lang === "es" ? ["En Wonderful", "Antes, en Platzi", "En Brand Spa"][index] : ["At Wonderful", "Before that, at Platzi", "At Brand Spa"][index]}</h2>
          <p class="editorial-story__meta">{role.meta}</p>
          <p>{role.body}</p>
        </article>
      ))}
    </section>

    <section class="editorial-section" id="projects" aria-labelledby="projects-heading">
      <div class="editorial-project">
        <h2 id="projects-heading">{cifro.title}</h2>
        <p class="editorial-story__meta">{cifro.meta}</p>
        <p>{lang === "es" ? "Mantengo Cifro, mi app para iPhone, hecha con SwiftUI." : "I maintain Cifro, my iPhone app, built with SwiftUI."}</p>
        <p>{cifro.text}</p>
        <p class="editorial-links">
          <a class="editorial-link" href={cifro.links.find((link) => link.external)?.href} target="_blank" rel="noopener noreferrer">{copy.appStore}</a>
          <span aria-hidden="true"> · </span>
          <a class="editorial-link" href={cifro.links.find((link) => !link.external)?.href}>{lang === "es" ? "Conoce Cifro" : "About Cifro"}</a>
        </p>
      </div>
      <h3>{copy.tools}</h3>
      <ul class="editorial-tool-list">
        {tools.map((tool) => (
          <li>
            <h3>{tool.title} <span>{tool.meta}</span></h3>
            <p>{tool.text}</p>
            <p class="editorial-links">
              {tool.links.map((link, index, links) => (
                <><a class="editorial-link" href={link.href} target={link.external ? "_blank" : undefined} rel={link.external ? "noopener noreferrer" : undefined}>{link.label}</a>{index < links.length - 1 && <span aria-hidden="true"> · </span>}</>
              ))}
            </p>
          </li>
        ))}
      </ul>
    </section>

    {latestPosts.length > 0 && (
      <section class="editorial-section" id="blog" aria-labelledby="blog-heading">
        <h2 id="blog-heading">{copy.writing}</h2>
        <ul class="editorial-posts">
          {latestPosts.map((post) => (
            <li><a class="editorial-link" href={postPath(post.slug)}>{post.title}</a><span>{formatPostDate(post.datePublished, lang)}{post.lang !== lang && ` · ${copy.inSpanish}`}</span></li>
          ))}
        </ul>
      </section>
    )}

    <section class="editorial-section editorial-photo" aria-label={copy.about}>
      <figure>
        <img
          src="/images/wwdc26-1600.webp"
          srcset="/images/wwdc26-900.webp 900w, /images/wwdc26-1600.webp 1600w"
          sizes="(max-width: 744px) calc(100vw - 40px), 700px"
          alt={t.heroAlt}
          width="1600"
          height="1067"
          loading="lazy"
          decoding="async"
        />
        <figcaption>{t.caption}</figcaption>
      </figure>
    </section>

    <section class="editorial-section editorial-contact" id="contact" aria-labelledby="contact-heading">
      <h2 id="contact-heading">{s.contact}</h2>
      <p>{t.contact}</p>
      <p><a class="editorial-link" href={profileLinks.linkedin} target="_blank" rel="me noopener noreferrer">LinkedIn</a><span aria-hidden="true"> · </span><a class="editorial-link" href={`mailto:${contactEmail}`}>{contactEmail}</a></p>
    </section>
  </div>
</BaseLayout>
