---
import "../../styles/home.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../ui/Button.astro";
import Card from "../ui/Card.astro";
import InsetList from "../ui/InsetList.astro";
import PostList from "../ui/PostList.astro";
import Section from "../ui/Section.astro";
import StatGrid from "../ui/StatGrid.astro";
import { FULL_NAME, SITE_HANDLE, SITE_URL, personId, personImageId, profileLinks, websiteId } from "../../data/site";
import { capabilities, contactEmail, experience, home, paths, projects, ui, alternatesFor, type Lang } from "../../data/profile";
import { sortedPosts } from "../../data/posts";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = home[lang];
const s = ui[lang].sections;
const p = paths[lang];
const latestPosts = sortedPosts().slice(0, 3);

const profileJsonLd = {
  "@type": "ProfilePage",
  "@id": `${SITE_URL}${p.home}#webpage`,
  url: `${SITE_URL}${p.home}`,
  inLanguage: lang,
  name: `${FULL_NAME} (${SITE_HANDLE})`,
  isPartOf: { "@id": websiteId },
  mainEntity: { "@id": personId },
  about: { "@id": personId },
  primaryImageOfPage: { "@id": personImageId },
  description: t.description,
};
---

<BaseLayout title={t.title} description={t.description} lang={lang} ogType="profile" jsonLd={profileJsonLd} alternates={alternatesFor("home")}>
  <section class="hero">
    <div class="container">
      <p class="hero__eyebrow enter" style="--i: 0">{t.eyebrow}</p>
      <h1 class="enter" style="--i: 1">{FULL_NAME}</h1>
      <p class="hero__lead enter" style="--i: 2" set:html={t.lead} />
      <div class="btn-row enter" style="--i: 3">
        <Button href={p.work}>{t.primary}</Button>
        <a class="text-link" href={profileLinks.linkedin} target="_blank" rel="me noopener noreferrer">{t.secondary}</a>
      </div>
    </div>
    <figure class="hero__media container">
      <div class="hero__frame">
        <img
          src="/images/wwdc26-1600.webp"
          srcset="/images/wwdc26-900.webp 900w, /images/wwdc26-1600.webp 1600w"
          sizes="(max-width: 800px) calc(100vw - 44px), 760px"
          alt={t.heroAlt}
          width="1600"
          height="1067"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <figcaption>{t.caption}</figcaption>
    </figure>
  </section>

  <section class="hero-stats">
    <div class="container"><StatGrid items={t.stats} /></div>
  </section>

  <Section id="about" title={s.about}>
    <div class="about">
      <div class="about-copy">
        {t.about.map((paragraph) => <p set:html={paragraph} />)}
      </div>
      <figure class="about__portrait">
        <img
          src="/images/apple-park-portrait-1000.webp"
          srcset="/images/apple-park-portrait-600.webp 600w, /images/apple-park-portrait-1000.webp 1000w"
          sizes="(max-width: 800px) calc(100vw - 44px), 320px"
          alt={t.portraitAlt}
          width="1000"
          height="1000"
          loading="lazy"
          decoding="async"
        />
        <figcaption>{t.portraitCaption}</figcaption>
      </figure>
    </div>
  </Section>

  <Section id="experience" title={s.experience}>
    <InsetList items={experience[lang]} />
    <div class="btn-row"><a class="text-link" href={p.work}>{ui[lang].fullHistory}</a></div>
  </Section>

  <Section id="projects" title={s.projects}>
    <div class="card-grid card-grid--2">
      {projects[lang].map((project) => (
        <Card title={project.title} meta={project.meta} icon={project.icon} glyph={project.glyph} links={project.links}>
          <p>{project.text}</p>
        </Card>
      ))}
    </div>
  </Section>

  <Section id="capabilities" title={s.capabilities}>
    <div class="card-grid card-grid--3">
      {capabilities[lang].map((group) => (
        <Card title={group.title}>
          <ul class="plain-list">{group.items.map((item) => <li>{item}</li>)}</ul>
        </Card>
      ))}
    </div>
  </Section>

  {latestPosts.length > 0 && (
    <Section id="blog" title={s.blog}>
      <PostList posts={latestPosts} lang={lang} />
      <div class="btn-row"><a class="text-link" href={p.blog}>{ui[lang].allPosts}</a></div>
    </Section>
  )}

  <Section id="contact" title={s.contact}>
    <div class="contact">
      <p>{t.contact}</p>
      <div class="btn-row">
        <Button href={profileLinks.linkedin} external>LinkedIn</Button>
        <a class="text-link" href={`mailto:${contactEmail}`}>{contactEmail}</a>
      </div>
    </div>
  </Section>
</BaseLayout>
