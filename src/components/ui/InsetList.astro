---
import type { InsetItem } from "./types";

interface Props {
  items: InsetItem[];
}

const { items } = Astro.props;
---

<ul class:list={["inset-list", { "inset-list--plain": items.every((item) => !item.mark) }]}>
  {items.map((item) => (
    <li class="inset-list__row">
      {item.mark && <span class:list={["inset-list__mark", `tint-${item.tint ?? "gray"}`]} aria-hidden="true">{item.mark}</span>}
      <div>
        <h3 class="inset-list__title">{item.title}</h3>
        {item.subtitle && <p class="inset-list__subtitle">{item.subtitle}</p>}
      </div>
      {item.meta && <span class:list={["inset-list__meta", { "inset-list__meta--live": item.live }]}>{item.meta}</span>}
      {item.body && <p class="inset-list__body">{item.body}</p>}
    </li>
  ))}
</ul>
