---
import TagList from "./TagList.astro";

interface Props {
  title: string;
  meta?: string;
  icon?: { src: string; alt: string };
  glyph?: "layers" | "terminal" | "viewfinder";
  glyphColor?: "blue" | "indigo" | "orange" | "green" | "pink" | "gray";
  tags?: string[];
  links?: { href: string; label: string; external?: boolean }[];
  headingLevel?: 2 | 3;
  tone?: "surface" | "soft";
  id?: string;
}

const { title, meta, icon, glyph, glyphColor = "blue", tags = [], links = [], headingLevel = 3, tone = "surface", id } = Astro.props;
const Heading = headingLevel === 2 ? "h2" : "h3";
---

<article class:list={["card", { "card--soft": tone === "soft" }]} id={id}>
  {glyph && (
    <span class:list={["card__glyph", `tint-${glyphColor}`]} aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        {glyph === "layers" && <><path d="M12 3 3 7.5l9 4.5 9-4.5L12 3Z" /><path d="m3 12 9 4.5 9-4.5" /><path d="m3 16.5 9 4.5 9-4.5" /></>}
        {glyph === "terminal" && <><rect x="3" y="4" width="18" height="16" rx="3" /><path d="m7.5 9.5 3 2.5-3 2.5" /><path d="M13 15h3.5" /></>}
        {glyph === "viewfinder" && <><path d="M4 8V6a2 2 0 0 1 2-2h2M16 4h2a2 2 0 0 1 2 2v2M20 16v2a2 2 0 0 1-2 2h-2M8 20H6a2 2 0 0 1-2-2v-2" /><circle cx="12" cy="12" r="3.2" /></>}
      </svg>
    </span>
  )}
  {icon && <img class="card__icon" src={icon.src} alt={icon.alt} width="56" height="56" loading="lazy" decoding="async" />}
  {meta && <p class="card__meta">{meta}</p>}
  <Heading class="card__title">{title}</Heading>
  <slot />
  {tags.length > 0 && <TagList tags={tags} />}
  {links.length > 0 && (
    <div class="card__links">
      {links.map((link) => (
        <a
          class="text-link"
          href={link.href}
          target={link.external ? "_blank" : undefined}
          rel={link.external ? "noopener noreferrer" : undefined}
        >{link.label}</a>
      ))}
    </div>
  )}
</article>
