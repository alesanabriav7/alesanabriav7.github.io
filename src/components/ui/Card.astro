---
import TagList from "./TagList.astro";

interface Props {
  title?: string;
  meta?: string;
  icon?: { src: string; alt: string };
  tags?: string[];
  links?: { href: string; label: string; external?: boolean }[];
  headingLevel?: 2 | 3;
  tone?: "surface" | "soft";
  feature?: boolean;
  id?: string;
}

const { title, meta, icon, tags = [], links = [], headingLevel = 3, tone = "surface", feature = false, id } = Astro.props;
const Heading = headingLevel === 2 ? "h2" : "h3";
---

<article class:list={["card", { "card--soft": tone === "soft", "card--feature": feature && icon }]} id={id}>
  {icon && <img class="card__icon" src={icon.src} alt={icon.alt} width="56" height="56" loading="lazy" decoding="async" />}
  {meta && <p class="card__meta">{meta}</p>}
  {title && <Heading class="card__title">{title}</Heading>}
  <slot />
  {tags.length > 0 && <TagList tags={tags} />}
  {links.length > 0 && (
    <div class="card__links">
      {links.map((link) => (
        <a
          class="text-link"
          href={link.href}
          target={link.external ? "_blank" : undefined}
          rel={link.external ? "noopener noreferrer" : undefined}
        >{link.label}</a>
      ))}
    </div>
  )}
</article>
