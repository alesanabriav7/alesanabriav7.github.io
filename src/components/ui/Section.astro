---
interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  kicker?: string;
  reading?: boolean;
  reveal?: boolean;
}

const { id, eyebrow, title, kicker, reading = false, reveal = true } = Astro.props;
---

<section id={id} class="section">
  <div class:list={["container", { reveal, "container--reading": reading }]}>
    {eyebrow && <p class="eyebrow section__eyebrow">{eyebrow}</p>}
    {title && (
      <h2 class="section__title">
        {title}{kicker && <> <span class="section__kicker">{kicker}</span></>}
      </h2>
    )}
    <slot />
  </div>
</section>
