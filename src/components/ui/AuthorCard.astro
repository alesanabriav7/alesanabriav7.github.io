---
import { SITE_NAME, profileLinks } from "../../data/site";
import { paths, ui, type Lang } from "../../data/profile";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<aside class="author-card" aria-label={t.writtenBy}>
  <img class="author-card__photo" src="/images/apple-park-portrait-600.webp" alt={SITE_NAME} width="88" height="88" loading="lazy" decoding="async" />
  <div>
    <p class="author-card__label">{t.writtenBy}</p>
    <p class="author-card__name">{SITE_NAME}</p>
    <p class="author-card__bio">{t.authorBio}</p>
    <div class="author-card__links">
      <a class="text-link" href={paths[lang].about}>{t.aboutMe}</a>
      <a class="text-link" href={profileLinks.linkedin} target="_blank" rel="me noopener noreferrer">LinkedIn</a>
      <a class="text-link" href={profileLinks.x} target="_blank" rel="me noopener noreferrer">X</a>
    </div>
  </div>
</aside>
