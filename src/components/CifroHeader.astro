---
import SiteNav from "./ui/SiteNav.astro";
import { cifroAppStoreUrl, cifroCopy, cifroPath, type CifroLang } from "../data/cifro";

interface Props {
  lang?: CifroLang;
}

const { lang = "en" } = Astro.props;
const t = cifroCopy[lang].nav;
const home = cifroPath(lang);
const otherLang: CifroLang = lang === "en" ? "es" : "en";
const links = [
  { href: `${home}#features`, label: t.features },
  { href: `${home}#privacy`, label: t.privacy },
  { href: `${home}#faq`, label: t.faq },
  { href: cifroPath(otherLang), label: t.switchLabel, hreflang: otherLang },
];
---

<SiteNav
  wide
  brand={{ href: home, label: "Cifro", ariaLabel: t.homeLabel }}
  links={links}
  cta={{ href: cifroAppStoreUrl, label: t.download, external: true }}
  ariaLabel={t.navLabel}
  lang={lang}
/>
