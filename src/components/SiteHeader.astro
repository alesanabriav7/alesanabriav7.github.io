---
const { currentPath = "/", lang = "en", alternates = [] } = Astro.props;
const es = lang === "es";
const links = es
  ? [
      { href: "/es/trabajo", label: "Trabajo" },
      { href: "/es/proyectos", label: "Proyectos" },
      { href: "/cifro/es", label: "Cifro" },
      { href: "/blog", label: "Blog" },
      { href: "/es/sobre-mi", label: "Sobre mí" },
    ]
  : [
      { href: "/work", label: "Work" },
      { href: "/projects", label: "Projects" },
      { href: "/cifro", label: "Cifro" },
      { href: "/blog", label: "Blog" },
      { href: "/about", label: "About" },
    ];
const other = alternates.find((a) => a.hreflang === (es ? "en" : "es"));
---

<header class="site-header">
  <div class="shell nav-shell">
    <a class="wordmark" href={es ? "/es/" : "/"} aria-label={es ? "Alejandro Sanabria, inicio" : "Alejandro Sanabria home"}>Alejandro Sanabria</a>
    <nav aria-label={es ? "Navegación principal" : "Primary navigation"}>
      {links.map((link) => (
        <a class:list={["nav-link", { active: currentPath === link.href }]} href={`${link.href}/`}>
          {link.label}
        </a>
      ))}
      {other && (
        <a class="nav-link" href={other.href} hreflang={other.hreflang} lang={other.hreflang}>{es ? "English" : "Español"}</a>
      )}
    </nav>
  </div>
</header>
