---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "./ui/Button.astro";
import Card from "./ui/Card.astro";
import Faq from "./ui/Faq.astro";
import SectionHeading from "./ui/SectionHeading.astro";
import { absoluteUrl, personId, personNode } from "../data/site";
import { cifroAlternates, cifroAppStoreId, cifroAppStoreUrl, cifroCopy, cifroPath, type CifroLang } from "../data/cifro";

interface Props {
  lang: CifroLang;
}

const { lang } = Astro.props;
const t = cifroCopy[lang];
const shot = (name: string) => `/cifro/v1.1/${lang}/${name}.webp`;
const pageUrl = absoluteUrl(cifroPath(lang));

const appNode = {
  "@type": ["SoftwareApplication", "MobileApplication"],
  "@id": `${absoluteUrl("/cifro/")}#app`,
  name: "Cifro",
  alternateName: lang === "es" ? "Cifro – Presupuesto y Gastos" : "Cifro – Budget Planner",
  applicationCategory: "FinanceApplication",
  applicationSubCategory: lang === "es" ? "Finanzas personales" : "Personal finance",
  operatingSystem: "iOS 26.0 or later",
  softwareVersion: "1.1",
  url: pageUrl,
  downloadUrl: cifroAppStoreUrl,
  installUrl: cifroAppStoreUrl,
  sameAs: cifroAppStoreUrl,
  inLanguage: ["en", "es"],
  image: absoluteUrl("/cifro/icon.jpg"),
  screenshot: t.features.map((feature) => absoluteUrl(shot(feature.image))),
  featureList: t.featureList,
  offers: { "@type": "Offer", price: 0, priceCurrency: "USD" },
  author: { "@id": personId },
  description: t.meta.description,
};

const faqNode = {
  "@type": "FAQPage",
  "@id": `${pageUrl}#faq`,
  inLanguage: lang,
  mainEntity: t.faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
---

<BaseLayout
  variant="cifro"
  lang={lang}
  title={t.meta.title}
  description={t.meta.description}
  image={`/cifro/v1.1/og-${lang}.png`}
  imageAlt={t.meta.ogAlt}
  favicon="/cifro/icon.jpg"
  alternates={cifroAlternates}
  appStoreId={cifroAppStoreId}
  jsonLd={[personNode, appNode, faqNode]}
>
  <section class="cifro-hero">
    <div class="shell cifro-hero-grid">
      <div class="cifro-hero-copy">
        <p class="eyebrow">{t.hero.eyebrow}</p>
        <h1>{t.hero.title}</h1>
        <p class="cifro-lede">{t.hero.body}</p>
        <div class="btn-row">
          <Button href={cifroAppStoreUrl} external>{t.hero.primary}</Button>
          <Button href="#features" variant="secondary">{t.hero.secondary}</Button>
        </div>
        <p class="cifro-note">{t.hero.note}</p>
      </div>
      <div class="cifro-hero-phones">
        <figure class="cifro-phone cifro-phone-back">
          <img src={shot("where")} alt={t.hero.secondImageAlt} width="660" height="1434" loading="eager" decoding="async" />
        </figure>
        <figure class="cifro-phone cifro-phone-front">
          <img src={shot("home")} alt={t.hero.imageAlt} width="660" height="1434" loading="eager" fetchpriority="high" decoding="async" />
        </figure>
      </div>
    </div>
    <div class="shell">
      <ul class="cifro-highlights">
        {t.highlights.map((highlight) => <li>{highlight}</li>)}
      </ul>
    </div>
  </section>

  <section id="features" class="cifro-section">
    <div class="shell">
      <SectionHeading eyebrow={t.featuresHeading.eyebrow} title={t.featuresHeading.title} body={t.featuresHeading.body} />
      <div class="cifro-features">
        {t.features.map((feature, index) => (
          <article id={feature.id} class:list={["cifro-feature", { reverse: index % 2 === 1 }]}>
            <div class="cifro-feature-copy">
              <p class="eyebrow">{feature.eyebrow}</p>
              <h3>{feature.title}</h3>
              <p>{feature.body}</p>
              <ul>
                {feature.points.map((point) => <li>{point}</li>)}
              </ul>
            </div>
            <figure class="cifro-phone">
              <img src={shot(feature.image)} alt={feature.alt} width="660" height="1434" loading="lazy" decoding="async" />
            </figure>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="cifro-section cifro-section--tint">
    <div class="shell">
      <SectionHeading eyebrow={t.capture.eyebrow} title={t.capture.title} />
      <div class="card-grid card-grid--4">
        {t.capture.items.map((item) => <Card title={item.title} tone="soft"><p>{item.body}</p></Card>)}
      </div>
    </div>
  </section>

  <section id="privacy" class="cifro-section">
    <div class="shell">
      <SectionHeading eyebrow={t.privacy.eyebrow} title={t.privacy.title} />
      <div class="card-grid card-grid--4">
        {t.privacy.items.map((item) => <Card title={item.title}><p>{item.body}</p></Card>)}
      </div>
    </div>
  </section>

  <section id="faq" class="cifro-section cifro-section--tint">
    <div class="shell cifro-faq-shell">
      <SectionHeading eyebrow={t.faqHeading.eyebrow} title={t.faqHeading.title} />
      <Faq items={t.faqs} />
    </div>
  </section>

  <section class="cifro-section cifro-cta">
    <div class="shell">
      <h2>{t.cta.title}</h2>
      <p>{t.cta.body}</p>
      <div class="btn-row">
        <Button href={cifroAppStoreUrl} external>{t.cta.primary}</Button>
        <Button href="/cifro/support/" variant="secondary">{t.cta.secondary}</Button>
      </div>
    </div>
  </section>
</BaseLayout>
