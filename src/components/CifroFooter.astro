---
import SiteFooter from "./ui/SiteFooter.astro";
import { SITE_NAME } from "../data/site";
import { cifroAppStoreUrl, cifroCopy, type CifroLang } from "../data/cifro";

interface Props {
  lang?: CifroLang;
}

const { lang = "en" } = Astro.props;
const t = cifroCopy[lang].footer;
const links = [
  { href: "/cifro/privacy/", label: t.privacy },
  { href: "/cifro/support/", label: t.support },
  { href: cifroAppStoreUrl, label: "App Store", external: true },
];
---

<SiteFooter wide links={links} ariaLabel={t.navLabel}>
  {t.tagline} · {t.madeBy} <a href={lang === "es" ? "/es/" : "/"} rel="author">{SITE_NAME}</a> {lang === "es" ? "en Bogotá" : "in Bogotá"}
</SiteFooter>
