---
import { cifroAppStoreUrl, cifroCopy, type CifroLang } from "../data/cifro";

interface Props {
  lang?: CifroLang;
}

const { lang = "en" } = Astro.props;
const t = cifroCopy[lang].footer;
---

<footer class="cifro-footer">
  <div class="shell footer-content">
    <p>{t.tagline}</p>
    <nav aria-label={t.navLabel}>
      <a href="/cifro/privacy/">{t.privacy}</a>
      <a href="/cifro/support/">{t.support}</a>
      <a href={cifroAppStoreUrl} target="_blank" rel="noopener noreferrer">App Store</a>
    </nav>
  </div>
</footer>
