---
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/components.css";
import "../styles/cifro.css";
import ColorModeScript from "../components/ColorModeScript.astro";
import CifroFooter from "../components/CifroFooter.astro";
import CifroHeader from "../components/CifroHeader.astro";
import SiteFooter from "../components/ui/SiteFooter.astro";
import SiteNav from "../components/ui/SiteNav.astro";
import { personalContact, personalFooterLinks, personalNavLinks } from "../data/navigation";
import { paths, ui } from "../data/profile";
import {
  SITE_NAME,
  SITE_URL,
  DEFAULT_IMAGE,
  DEFAULT_IMAGE_ALT,
  absoluteUrl,
  personNode,
  websiteNode,
  cifroAppNode,
  webPageNodes,
  type Crumb,
} from "../data/site";

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  favicon?: string;
  noindex?: boolean;
  ogType?: "website" | "profile" | "article";
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  variant?: "personal" | "cifro";
  lang?: "en" | "es";
  alternates?: { hreflang: string; href: string }[];
  appStoreId?: string;
  breadcrumbs?: Crumb[];
}

const {
  title,
  description,
  image = DEFAULT_IMAGE,
  imageAlt = DEFAULT_IMAGE_ALT,
  favicon = "/favicon.svg",
  noindex = false,
  ogType = "website",
  jsonLd,
  variant = "personal",
  lang = "en",
  alternates = [],
  appStoreId,
  breadcrumbs,
} = Astro.props;
const isCifro = variant === "cifro";
const ogLocale = lang === "es" ? "es_LA" : "en_US";
const canonical = new URL(Astro.url.pathname, SITE_URL).toString();
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const fullTitle = isCifro || title.includes(SITE_NAME) ? title : `${title} — ${SITE_NAME}`;
const imageUrl = absoluteUrl(image);
const metadataSiteName = isCifro ? "Cifro" : SITE_NAME;

const extraNodes = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const identityNodes = isCifro ? [] : [personNode, websiteNode, cifroAppNode];
const pageNodes = breadcrumbs && !noindex ? webPageNodes(canonical, fullTitle, description, breadcrumbs, lang) : [];
const structuredDataNodes = [...identityNodes, ...pageNodes, ...extraNodes];
const structuredDataJson = structuredDataNodes.length > 0
  ? JSON.stringify({ "@context": "https://schema.org", "@graph": structuredDataNodes }).replace(/</g, "\\u003c")
  : null;
---

<!doctype html>
<html lang={lang} data-theme={variant}>
  <head>
    <meta charset="UTF-8" />
    <ColorModeScript />
    <meta name="google-site-verification" content="l95xqS-N0KHT5-3z9O5GaMDLjR-_60SRadHGRSqD3Qw" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={SITE_NAME} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content={isCifro ? "#f2f2f7" : "#ffffff"} />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content={isCifro ? "#000000" : "#0b0b0b"} />
    <link rel="canonical" href={canonical} />
    {alternates.map((alternate) => <link rel="alternate" hreflang={alternate.hreflang} href={absoluteUrl(alternate.href)} />)}
    {appStoreId && <meta name="apple-itunes-app" content={`app-id=${appStoreId}`} />}
    <link rel="icon" href={favicon} />
    {!isCifro && <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} · Blog`} href="/rss.xml" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={metadataSiteName} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <title>{fullTitle}</title>
    {structuredDataJson && <script is:inline type="application/ld+json" set:html={structuredDataJson}></script>}
  </head>
  <body>
    {isCifro ? (
      <CifroHeader lang={lang} />
    ) : (
      <SiteNav
        brand={{ href: paths[lang].home, label: SITE_NAME, shortLabel: "A. Sanabria", ariaLabel: ui[lang].nav.homeLabel }}
        links={personalNavLinks(lang, alternates)}
        cta={personalContact(lang)}
        currentPath={currentPath}
        ariaLabel={ui[lang].nav.label}
      />
    )}
    <main>
      <slot />
    </main>
    {isCifro ? (
      <CifroFooter lang={lang} />
    ) : (
      <SiteFooter links={personalFooterLinks(lang)} ariaLabel={ui[lang].nav.footer}>{`© ${new Date().getFullYear()} ${SITE_NAME}`}</SiteFooter>
    )}
    <script>
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const revealElements = document.querySelectorAll<HTMLElement>(".reveal");
      if (!reducedMotion && revealElements.length > 0) {
        document.body.classList.add("motion-ready");
        const observer = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add("visible");
            observer.unobserve(entry.target);
          }
        }, { threshold: 0.12 });
        for (const element of revealElements) {
          const rect = element.getBoundingClientRect();
          if (rect.top < window.innerHeight && rect.bottom > 0) element.classList.add("visible");
          else observer.observe(element);
        }
      }
    </script>
  </body>
</html>
