---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Faq from "../../components/ui/Faq.astro";
import PageTitle from "../../components/ui/PageTitle.astro";
import Prose from "../../components/ui/Prose.astro";

const supportJsonLd = {
  "@type": "WebPage",
  "@id": "https://alejandrosanabria.com/cifro/support/#webpage",
  url: "https://alejandrosanabria.com/cifro/support/",
  inLanguage: "en",
  name: "Cifro Support: help with the iPhone budget app",
  about: { "@id": "https://alejandrosanabria.com/cifro/#app" },
};

const faqs = [
  { question: "Where is my data?", answer: "Cifro stores data on your iPhone and, when you use iCloud sync, in your private iCloud account. Deleting the app may remove local data but does not guarantee deletion of iCloud or backup copies. Check your iCloud and backup settings before uninstalling." },
  { question: "How does sync work?", answer: "iCloud sync uses Apple’s CloudKit service and your own private iCloud account to sync app data between your devices. There is no separate Cifro account." },
  { question: "Can I use other currencies?", answer: "Yes. Choose your main currency and log expenses in others. Cifro downloads a USD-based exchange-rate table from ExchangeRate-API and uses it to convert currencies. The rate request does not include your financial records. iCloud sync also uses the internet." },
  { question: "Can I lock the app?", answer: "Yes, with Face ID or Touch ID." },
  { question: "Which iPhones are supported?", answer: "iPhone with iOS 26 or later. Cifro AI needs an iPhone that supports Apple Intelligence." },
];
---

<BaseLayout variant="cifro" title="Cifro Support: help with the iPhone budget app" description="Cifro support: how to contact me, where your data lives, iCloud sync, currencies, Face ID and supported iPhones." favicon="/cifro/icon.jpg" jsonLd={supportJsonLd}>
  <div class="cifro-page-body">
    <PageTitle reading eyebrow="Cifro" title="Cifro support">Questions about <a href="/cifro/">Cifro</a>? Email me and I'll answer.</PageTitle>
    <div class="container container--reading">
      <Prose>
        <h2>Contact</h2>
        <p>Email <a href="mailto:me@alesanabriav.com?subject=Cifro%20support">me@alesanabriav.com</a> with the Cifro version, your iPhone model, and a short description of what happened. Do not include personal financial information.</p>
        <h2>Common questions</h2>
      </Prose>
      <Faq items={faqs} />
      <Prose>
        <h2>Privacy</h2>
        <p>Read the <a href="/cifro/privacy/">Cifro privacy policy</a>.</p>
      </Prose>
    </div>
  </div>
</BaseLayout>
