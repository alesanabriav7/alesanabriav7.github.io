---
import "../../styles/cifro.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout variant="cifro" title="Cifro Support" description="Support and help for Cifro, a private-by-design iOS finance app." favicon="/cifro/icon.jpg">
  <section class="page-intro compact"><div class="shell"><p class="eyebrow">Cifro</p><h1>Support</h1><p>Simple help for a product designed to keep your data on your device.</p></div></section>
  <section class="section tint"><div class="shell prose"><h2>Need help?</h2><p>Email <a href="mailto:me@alesanabriav.com?subject=Cifro%20support">me@alesanabriav.com</a> with the Cifro version, your iPhone model, and a short description of what happened. Do not include personal financial information.</p><h2>Where is my data?</h2><p>Cifro keeps its data locally on your device. Deleting the app may remove locally stored app data; review your device backup settings before uninstalling if you need to retain it.</p><h2>Privacy</h2><p>Read the <a href="/cifro/privacy/">Cifro privacy policy</a>.</p></div></section>
</BaseLayout>
