---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Faq from "../../components/ui/Faq.astro";
import PageTitle from "../../components/ui/PageTitle.astro";
import Prose from "../../components/ui/Prose.astro";

const faqs = [
  { question: "Where is my data?", answer: "Cifro keeps its data on your iPhone. Deleting the app may remove locally stored app data, so check your device backup settings before uninstalling if you need to keep it." },
  { question: "How does sync work?", answer: "Sync is optional and goes through your own private iCloud account. There is no Cifro account." },
  { question: "Can I use other currencies?", answer: "Yes. Choose your main currency and log expenses in others. Cifro converts them with current exchange rates, which is the only thing it fetches from the internet." },
  { question: "Can I lock the app?", answer: "Yes, with Face ID or Touch ID." },
  { question: "Which iPhones are supported?", answer: "iPhone with iOS 26 or later. Cifro AI needs an iPhone that supports Apple Intelligence." },
];
---

<BaseLayout variant="cifro" title="Cifro Support: help with the iPhone budget app" description="Cifro support: how to contact me, where your data lives, iCloud sync, currencies, Face ID and supported iPhones." favicon="/cifro/icon.jpg">
  <div class="cifro-page-body">
    <PageTitle reading eyebrow="Cifro" title="Cifro support">Questions about <a href="/cifro/">Cifro</a>? Email me and I'll answer.</PageTitle>
    <div class="container container--reading">
      <Prose>
        <h2>Contact</h2>
        <p>Email <a href="mailto:me@alesanabriav.com?subject=Cifro%20support">me@alesanabriav.com</a> with the Cifro version, your iPhone model, and a short description of what happened. Do not include personal financial information.</p>
        <h2>Common questions</h2>
      </Prose>
      <Faq items={faqs} />
      <Prose>
        <h2>Privacy</h2>
        <p>Read the <a href="/cifro/privacy/">Cifro privacy policy</a>.</p>
      </Prose>
    </div>
  </div>
</BaseLayout>
