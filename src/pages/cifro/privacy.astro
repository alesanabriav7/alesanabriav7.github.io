import "../../styles/cifro.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout variant="cifro" title="Cifro Privacy" description="Privacy policy for Cifro, a private-by-design iOS finance app." favicon="/cifro/icon.jpg" noindex={true}>
  <section class="page-intro compact"><div class="shell"><p class="eyebrow">Cifro</p><h1>Privacy policy</h1><p>Last updated: April 2026</p></div></section>
  <section class="section tint"><div class="shell prose"><p><strong>Cifro does not collect, store, transmit, or share personal data.</strong></p><h2>Data stays on your device</h2><p>Transactions, budgets, notes, and settings are stored exclusively on your device using local storage. No data leaves your device through Cifro.</p><h2>No account or analytics profile</h2><p>Cifro does not require an account and does not create a cloud profile for your financial information.</p><h2>On-device intelligence</h2><p>Product intelligence uses on-device capabilities. Your financial context is not sent to a Cifro server for AI processing.</p><h2>Your control</h2><p>Because Cifro has no servers and no data transmission, there is no remote financial record to request, delete, or export. Your data remains under your control on your device.</p><h2>Contact</h2><p>For questions, email <a href="mailto:me@alesanabriav.com">me@alesanabriav.com</a>.</p></div></section>
</BaseLayout>
