---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Faq from "../../components/ui/Faq.astro";
import PageTitle from "../../components/ui/PageTitle.astro";
import Prose from "../../components/ui/Prose.astro";
import Section from "../../components/ui/Section.astro";

const faqs = [
  { question: "Is this an application framework?", answer: "It is a toolkit of instructions and supporting resources for coding agents." },
  { question: "Does it include persistence guidance?", answer: "Yes. The public toolkit includes focused GRDB workflows alongside broader feature architecture." },
  { question: "Does it replace code review?", answer: "Review and verification remain part of using generated changes in a real project." },
];
---

<BaseLayout
  title="iOS Architecture Skills for Claude Code and AI Coding Agents"
  description="Open-source skills that help Claude Code and other coding agents build SwiftUI features with clear boundaries, GRDB persistence, tests and visual checks."
  breadcrumbs={[{ name: "Projects", href: "/projects/" }, { name: "ios-architect-skill", href: "/projects/ios-architect/" }]}
>
  <PageTitle reading eyebrow="Open source" title="iOS architecture skills for Claude Code and AI coding agents">
    By <a href="/">Alejandro Sanabria</a> · Forward Deployed Engineer at Wonderful
  </PageTitle>

  <Section reading>
    <Prose>
      <p>I publish ios-architect-skill, a set of skills I use with coding agents for iOS development. They cover feature boundaries, GRDB persistence, async tests, and visual checks.</p>
      <p>The toolkit covers SwiftUI, Clean Architecture, MVVM, GRDB, and Swift concurrency. Its skills divide responsibilities across architecture, reusable UI, platform integration, storage, testing, and visual checks.</p>
      <h2>What the toolkit covers</h2>
      <p>Use the architecture skill for a new app or feature. Use the persistence skill for a database change, and the testing skill for concurrency and dependency injection. Pick the one that matches the size of the change.</p>
      <h2>Start with one feature</h2>
      <p>Choose a small feature and describe its expected behavior, storage needs, and existing project conventions. Follow the repository's installation instructions, then inspect the generated changes and verify the result in your project.</p>
      <h2>Try it on a bounded feature</h2>
      <p>Install the toolkit using the <a href="https://github.com/alesanabriav7/ios-architect-skill">repository instructions</a>, then start with a request that states behavior and constraints:</p>
      <pre><code>Add a saved-items feature to this SwiftUI app. Persist items locally, follow the existing feature boundaries, and verify that saved items survive relaunch.</code></pre>
      <p>Review the domain model, storage boundary, and view state separately. The result still needs to compile and be exercised in your app. For the visual check, I use <a href="/projects/screenshots-ios/">screenshots-ios</a>.</p>
    </Prose>
  </Section>

  <Section reading title="Questions">
    <Faq items={faqs} />
    <div class="btn-row"><a class="text-link" href="/projects/">All projects</a></div>
  </Section>
</BaseLayout>
