---
import BaseLayout from "../../layouts/BaseLayout.astro";

const projects = [
  {
    title: "Cifro",
    text: "Budget app for iPhone. Free, no ads, no account, no bank login. You log expenses by typing, by voice or by scanning a receipt. I built it with SwiftUI and Apple Foundation Models, and the AI runs on the phone.",
    links: [
      { href: "/cifro/", label: "Cifro page" },
      { href: "https://apps.apple.com/app/id6759523370", label: "App Store" },
    ],
  },
  {
    title: "appstore-tools",
    text: "TypeScript CLI and library for App Store Connect. It lists your apps, builds an IPA, reads and updates App Store metadata, and uploads builds.",
    links: [
      { href: "/projects/appstore-tools/", label: "App Store Connect CLI" },
      { href: "https://github.com/alesanabriav7/appstore-tools", label: "GitHub" },
    ],
  },
  {
    title: "screenshots-ios",
    text: "CLI for iOS simulator screenshots. It builds the app, sets the simulator status bar, launches it on the screen you choose with preview data, and saves the image. Settings live in a JSON file.",
    links: [
      { href: "/projects/screenshots-ios/", label: "iOS simulator screenshot CLI" },
      { href: "https://github.com/alesanabriav7/screenshots-ios", label: "GitHub" },
    ],
  },
  {
    title: "ios-architect-skill",
    text: "Skills for Claude Code and OpenClaw covering SwiftUI feature architecture, GRDB persistence, Swift concurrency tests and visual checks.",
    links: [
      { href: "/projects/ios-architect/", label: "iOS architecture skills" },
      { href: "https://github.com/alesanabriav7/ios-architect-skill", label: "GitHub" },
    ],
  },
];
---

<BaseLayout title="Projects by Alejandro Sanabria: Cifro, appstore-tools, screenshots-ios" description="Apps and open-source tools I build and use: Cifro for iPhone, an App Store Connect CLI, an iOS simulator screenshot CLI and iOS skills for AI coding agents.">
  <section class="page-intro"><div class="shell"><p class="eyebrow">Projects</p><h1>Things I've built</h1><p>One iPhone app and three open-source tools. I use the tools to build and release the app.</p></div></section>
  <section class="section tint"><div class="shell"><div class="card-grid">{projects.map((project) => <article class:list={["card", { featured: project.title === "Cifro" }]}><h2>{project.title}</h2><p>{project.text}</p><p>{project.links.map((link, i) => <>{i > 0 && " · "}<a href={link.href} target={link.href.startsWith("http") ? "_blank" : undefined} rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}>{link.label}</a></>)}</p></article>)}</div></div></section>
</BaseLayout>
