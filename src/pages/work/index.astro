---
import BaseLayout from "../../layouts/BaseLayout.astro";

const work = [
  { title: "Wonderful", type: "Forward Deployed Engineer", text: "I build AI agents for Wonderful's customers and connect them to the tools they already run.", tags: ["AI agents", "Integrations"] },
  { title: "Platzi", type: "iOS & Android lead", text: "8+ years. I joined as an early mobile engineer and ended up leading mobile engineering across iOS and Android: native Swift and Kotlin, React Native before that, shared standards and growing the team.", tags: ["iOS", "Android", "Swift", "Kotlin"] },
  { title: "Brand Spa", type: "Co-founder · full-stack engineer", text: "Client products for B2B companies: CMS platforms, e-commerce, quoting systems, website builders and internal tools. I built and ran the engineering side.", tags: ["B2B", "Laravel", "Rails", "React"] },
  { title: "Baubap", type: "Engineering manager", text: "A short stint to get Baubap's first iOS app out on a tight timeline.", tags: ["iOS", "Engineering management"] },
];
---

<BaseLayout title="Alejandro Sanabria: Work at Wonderful, Platzi and Brand Spa" description="Where I've worked: AI agents at Wonderful, 8+ years leading iOS and Android at Platzi, co-founding Brand Spa, and Baubap's first iOS app.">
  <section class="page-intro"><div class="shell"><p class="eyebrow">Work</p><h1>Where I've worked: Wonderful, Platzi and more</h1><p>I'm a Forward Deployed Engineer at <a href="https://wonderful.ai">Wonderful</a> now. Most of my career before that was mobile: iOS and Android at Platzi, and web products for clients at Brand Spa.</p></div></section>
  <section class="section tint"><div class="shell"><div class="card-grid">{work.map((item) => <article class="card"><p class="eyebrow">{item.type}</p><h2>{item.title}</h2><p>{item.text}</p><ul class="tag-list">{item.tags.map((tag) => <li>{tag}</li>)}</ul></article>)}</div></div></section>
  <section class="section"><div class="shell"><div class="section-heading"><p class="eyebrow">My own app</p><h2>Cifro</h2></div><div class="card-grid"><article class="card featured"><p class="eyebrow">Cifro</p><h3>A budget app for iPhone.</h3><p>SwiftUI and Apple Foundation Models, with the AI running on the phone. No Cifro account, ads or third-party tracking. Optional sync uses your private iCloud account.</p><a href="/cifro/">Cifro budget app →</a></article></div></div></section>
  <section class="section tint"><div class="shell prose"><h2>Tools I use to ship</h2><p><a href="/projects/ios-architect/">iOS architecture skills for Claude Code</a> keep feature boundaries clear when an agent writes the code. <a href="/projects/appstore-tools/">appstore-tools</a> handles App Store Connect metadata and uploads. <a href="/projects/screenshots-ios/">screenshots-ios</a> captures the simulator in the same state every time.</p><p><a href="/projects/">All projects →</a></p></div></section>
</BaseLayout>
