---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { brandedTitle, topicPageNode } from "../../data/site";

const title = brandedTitle("Work: Brand Spa, Platzi and Wonderful");
const description = "Brand Spa (Dec 2012–Oct 2017), Platzi mobile (Oct 2017–Jun 2026), Forward Deployed Engineer at Wonderful since July 2026.";
const pageJsonLd = topicPageNode("/work/", title, description, "en");

const work = [
  { title: "Brand Spa", type: "Co-founder · full-stack engineer · Dec 2012–Oct 2017", text: "Client products for B2B companies: CMS platforms, e-commerce, quoting systems, website builders and internal tools. I co-founded the agency and ran engineering for almost five years.", tags: ["B2B", "Laravel", "Rails", "React"] },
  { title: "Platzi", type: "iOS & Android lead · Oct 2017–Jun 2026", text: "8+ years. I joined as an early mobile engineer and ended up leading mobile engineering across iOS and Android: native Swift and Kotlin, React Native before that, shared standards and growing the team. Apple recognized the team's Foundation Models and Liquid Glass work.", tags: ["iOS", "Android", "Swift", "Kotlin"] },
  { title: "Wonderful", type: "Forward Deployed Engineer · Jul 2026–present", text: "I build AI agents for Wonderful's customers and connect them to the tools they already run.", tags: ["AI agents", "Integrations"] },
];
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={pageJsonLd}
  alternates={[
    { hreflang: "en", href: "/work/" },
    { hreflang: "es", href: "/es/trabajo/" },
    { hreflang: "x-default", href: "/work/" },
  ]}
>
  <section class="page-intro"><div class="shell"><p class="eyebrow">Work</p><h1>Where I've worked: Brand Spa, Platzi and Wonderful</h1><p>I'm a Forward Deployed Engineer at <a href="https://wonderful.ai">Wonderful</a>. I've been in technology since 2012, about 14 years: I co-founded Brand Spa, then led mobile at Platzi.</p></div></section>
  <section class="section tint"><div class="shell"><div class="card-grid">{work.map((item) => <article class="card"><h2>{item.title}</h2><p class="card-role">{item.type}</p><p>{item.text}</p><ul class="tag-list">{item.tags.map((tag) => <li>{tag}</li>)}</ul></article>)}</div></div></section>
  <section class="section"><div class="shell"><div class="section-heading"><p class="eyebrow">My own app</p><h2>Cifro</h2></div><div class="card-grid"><article class="card featured"><p class="eyebrow">Cifro</p><h3>A budget app for iPhone.</h3><p>SwiftUI and Apple Foundation Models, with the AI running on the phone. No Cifro account, ads or third-party tracking. Optional sync uses your private iCloud account.</p><a href="/cifro/">Cifro budget app →</a></article></div></div></section>
  <section class="section tint"><div class="shell prose"><h2>Tools I use to ship</h2><p><a href="/projects/ios-architect/">iOS architecture skills for Claude Code</a> keep feature boundaries clear when an agent writes the code. <a href="/projects/appstore-tools/">appstore-tools</a> handles App Store Connect metadata and uploads. <a href="/projects/screenshots-ios/">screenshots-ios</a> captures the simulator in the same state every time.</p><p><a href="/projects/">All projects →</a></p></div></section>
</BaseLayout>
