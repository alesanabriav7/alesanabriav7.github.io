---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Card from "../../components/ui/Card.astro";
import InsetList from "../../components/ui/InsetList.astro";
import PageTitle from "../../components/ui/PageTitle.astro";
import Section from "../../components/ui/Section.astro";
import { experience } from "../../data/experience";

const tools = [
  { title: "iOS Architecture Skills", meta: "AI coding workflow", glyph: "layers", tint: "indigo", text: "Make feature boundaries, persistence, and verification explicit when AI agents build SwiftUI features.", href: "/projects/ios-architect/" },
  { title: "App Store Tools", meta: "TypeScript CLI", glyph: "terminal", tint: "gray", text: "Release operations — metadata, IPAs, and uploads — from the command line.", href: "/projects/appstore-tools/" },
  { title: "Screenshots iOS", meta: "Simulator automation", glyph: "viewfinder", tint: "pink", text: "Repeatable simulator state for App Store assets and visual checks.", href: "/projects/screenshots-ios/" },
];
---

<BaseLayout
  title="Work: Forward Deployed & Product Engineering"
  description="Alejandro Sanabria's work across Forward Deployed Engineering at Wonderful.ai and 12+ years building software products, with native iOS and Android at the core."
  breadcrumbs={[{ name: "Work", href: "/work/" }]}
>
  <PageTitle eyebrow="Work" title="Forward deployed engineering, built on years of shipping products.">
    I connect customer workflows, AI systems, and product engineering — with 12+ years of building software products, mobile at the core, behind it.
  </PageTitle>

  <Section title="Experience." kicker="Where I've done the work.">
    <InsetList items={experience} />
  </Section>

  <Section title="Product proof." kicker="Some things are better shown shipped.">
    <div class="card-grid card-grid--2">
      <Card
        title="Cifro"
        meta="iOS app · App Store"
        icon={{ src: "/cifro/icon.jpg", alt: "Cifro app icon" }}
        links={[{ href: "/cifro/", label: "Explore Cifro" }]}
      >
        <p>Private-by-design personal finance on iOS. SwiftUI and Apple Foundation Models for on-device AI. No account, ads, or third-party tracking; optional sync through your private iCloud.</p>
      </Card>
      <Card title="Delivery tooling" meta="Open source" links={[{ href: "/projects/", label: "All projects" }]}>
        <p>The tools I use to plan, build, verify, and release software — published so other teams can use them too.</p>
      </Card>
    </div>
  </Section>

  <Section title="Tools." kicker="That support delivery.">
    <div class="card-grid card-grid--3">
      {tools.map((tool) => (
        <Card title={tool.title} meta={tool.meta} glyph={tool.glyph as "layers" | "terminal" | "viewfinder"} glyphColor={tool.tint as "indigo" | "gray" | "pink"} links={[{ href: tool.href, label: "Learn more" }]}><p>{tool.text}</p></Card>
      ))}
    </div>
  </Section>
</BaseLayout>
