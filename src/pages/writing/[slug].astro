---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Prose from "../../components/ui/Prose.astro";
import { absoluteUrl, personId, SITE_NAME } from "../../data/site";
import { formatPostDate, getPosts, readingMinutes, type Post } from "../../data/writing";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
const path = `/writing/${post.id}/`;
const date = formatPostDate(post.data.pubDate);
const minutes = readingMinutes(post.body);
const postJsonLd = {
  "@type": "BlogPosting",
  "@id": `${absoluteUrl(path)}#article`,
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  mainEntityOfPage: absoluteUrl(path),
  keywords: post.data.tags.join(", "),
  author: { "@id": personId },
  publisher: { "@id": personId },
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  jsonLd={postJsonLd}
  noindex={post.data.draft}
  breadcrumbs={[{ name: "Writing", href: "/writing/" }, { name: post.data.title, href: path }]}
>
  <article class="post">
    <header class="page-header">
      <div class="container container--reading">
        <p class="eyebrow">{post.data.draft ? "Draft · " : ""}{post.data.tags[0]}</p>
        <h1>{post.data.title}</h1>
        <p class="page-header__lead">{post.data.description}</p>
        <div class="post-byline">
          <img src="/images/apple-park-portrait-600.webp" alt="" width="40" height="40" />
          <span><a href="/" rel="author">{SITE_NAME}</a><br /><time datetime={post.data.pubDate.toISOString()}>{date}</time> · {minutes} min read</span>
        </div>
      </div>
    </header>
    <section class="section">
      <div class="container container--reading">
        <Prose><Content /></Prose>
        <div class="btn-row"><a class="text-link" href="/writing/">All writing</a></div>
      </div>
    </section>
  </article>
</BaseLayout>
