---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import AuthorCard from "../../components/ui/AuthorCard.astro";
import Byline from "../../components/ui/Byline.astro";
import PageTitle from "../../components/ui/PageTitle.astro";
import PostList from "../../components/ui/PostList.astro";
import Prose from "../../components/ui/Prose.astro";
import Section from "../../components/ui/Section.astro";
import TagList from "../../components/ui/TagList.astro";
import { absoluteUrl, personId } from "../../data/site";
import { getPosts, readingMinutes, type Post } from "../../data/writing";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, more: posts.filter((other) => other.id !== post.id).slice(0, 2) } }));
}

const { post, more } = Astro.props as { post: Post; more: Post[] };
const { Content } = await render(post);
const path = `/writing/${post.id}/`;
const postJsonLd = {
  "@type": "BlogPosting",
  "@id": `${absoluteUrl(path)}#article`,
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  mainEntityOfPage: absoluteUrl(path),
  keywords: post.data.tags.join(", "),
  author: { "@id": personId },
  publisher: { "@id": personId },
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  jsonLd={postJsonLd}
  noindex={post.data.draft}
  breadcrumbs={[{ name: "Writing", href: "/writing/" }, { name: post.data.title, href: path }]}
>
  <article class="post">
    <PageTitle reading eyebrow={`${post.data.draft ? "Draft · " : ""}${post.data.tags[0]}`} title={post.data.title}>
      {post.data.description}
      <Byline slot="meta" date={post.data.pubDate} minutes={readingMinutes(post.body)} />
    </PageTitle>

    <Section reading reveal={false}>
      <Prose><Content /></Prose>
      <TagList tags={post.data.tags} />
    </Section>

    <Section reading>
      <AuthorCard />
    </Section>
  </article>

  {more.length > 0 && (
    <Section reading title="More writing">
      <PostList posts={more} />
      <div class="btn-row"><a class="text-link" href="/writing/">All writing</a></div>
    </Section>
  )}
</BaseLayout>
