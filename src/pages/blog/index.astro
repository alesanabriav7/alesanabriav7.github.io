---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE_URL, personId, websiteId, brandedTitle } from "../../data/site";
import { posts, postPath } from "../../data/posts";

const title = brandedTitle("Notas sobre agentes de IA");
const description = "Notas sobre agentes de IA que uso. Hay un texto sobre un equipo de bots en Grok Bot: trámites, millas y citas.";
const blogJsonLd = {
  "@type": "Blog",
  "@id": `${SITE_URL}/blog/#blog`,
  url: `${SITE_URL}/blog/`,
  name: title,
  description,
  inLanguage: "es",
  isPartOf: { "@id": websiteId },
  author: { "@id": personId },
  blogPost: posts.map((post) => ({ "@id": `${SITE_URL}${postPath(post.slug)}#article` })),
};
---

<BaseLayout
  title={title}
  description={description}
  lang="es"
  jsonLd={blogJsonLd}
>
  <section class="page-intro"><div class="shell"><p class="eyebrow">Blog</p><h1>Notas sobre agentes de IA</h1><p>Escribo sobre agentes de IA que uso de verdad. También hago <a href="/cifro/es/">Cifro, una app de presupuesto para iPhone</a>.</p></div></section>
  <section class="section"><div class="shell article-list">
    {posts.map((post) => (
      <article lang={post.lang}>
        <time datetime={post.datePublished}>{post.datePublished}</time>
        <div><h2><a href={postPath(post.slug)}>{post.title}</a></h2><p>{post.description}</p></div>
      </article>
    ))}
  </div></section>
</BaseLayout>
