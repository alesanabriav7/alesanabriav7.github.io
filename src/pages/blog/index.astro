---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageTitle from "../../components/ui/PageTitle.astro";
import PostList from "../../components/ui/PostList.astro";
import Section from "../../components/ui/Section.astro";
import { SITE_URL, personId, websiteId } from "../../data/site";
import { postPath, sortedPosts } from "../../data/posts";

const posts = sortedPosts();
const blogJsonLd = {
  "@type": "Blog",
  "@id": `${SITE_URL}/blog/#blog`,
  url: `${SITE_URL}/blog/`,
  name: "Blog de Alejandro Sanabria",
  inLanguage: "es",
  isPartOf: { "@id": websiteId },
  author: { "@id": personId },
  blogPost: posts.map((post) => ({ "@id": `${SITE_URL}${postPath(post.slug)}#article` })),
};
---

<BaseLayout
  title="Blog | Alejandro Sanabria, Forward Deployed Engineer"
  description="Blog de Alejandro Sanabria, Forward Deployed Engineer en Bogotá: notas sobre agentes de IA, asistentes y cómo los uso en la vida real."
  lang="es"
  jsonLd={blogJsonLd}
  breadcrumbs={[{ name: "Blog", href: "/blog/" }]}
>
  <PageTitle eyebrow="Blog" title="Blog">
    Escribo sobre agentes de IA que uso de verdad. También hago <a href="/cifro/es/">Cifro, una app de presupuesto para iPhone</a>.
  </PageTitle>
  <Section>
    <PostList posts={posts} lang="es" />
  </Section>
</BaseLayout>
