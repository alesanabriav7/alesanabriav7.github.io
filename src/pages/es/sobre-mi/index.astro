---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { SITE_URL, PERSON_PHOTO, PERSON_PHOTO_ALT, personId, personImageId, websiteId, profileLinks } from "../../../data/site";

const aboutJsonLd = {
  "@type": ["AboutPage", "ProfilePage"],
  "@id": `${SITE_URL}/es/sobre-mi/#webpage`,
  url: `${SITE_URL}/es/sobre-mi/`,
  inLanguage: "es",
  name: "Sobre Alejandro Sanabria Villescas (alesanabriav)",
  isPartOf: { "@id": websiteId },
  mainEntity: { "@id": personId },
  about: { "@id": personId },
  primaryImageOfPage: { "@id": personImageId },
};

const profiles = [
  { label: "LinkedIn", href: profileLinks.linkedin },
  { label: "GitHub (alesanabriav7)", href: profileLinks.github },
  { label: "X (@alesanabriav)", href: profileLinks.x },
  { label: "Mis apps en la App Store", href: profileLinks.appStore },
  { label: "Mi perfil de profe en Platzi", href: profileLinks.platzi },
];
---

<BaseLayout
  title="Alejandro Sanabria Villescas (alesanabriav) | desde 2012"
  description="Alejandro Sanabria Villescas (alesanabriav) en Wonderful, en Bogotá. Unos 14 años en tecnología desde 2012: Brand Spa, móvil en Platzi y agentes para clientes."
  lang="es"
  ogType="profile"
  jsonLd={aboutJsonLd}
  alternates={[
    { hreflang: "en", href: "/about/" },
    { hreflang: "es", href: "/es/sobre-mi/" },
    { hreflang: "x-default", href: "/about/" },
  ]}
>
  <section class="page-intro"><div class="shell"><img class="person-photo" src={PERSON_PHOTO} alt={PERSON_PHOTO_ALT} width="160" height="160" decoding="async" fetchpriority="high" /><p class="eyebrow">Sobre mí · alesanabriav</p><h1>Alejandro Sanabria Villescas</h1><p>Me conocen como Alejandro Sanabria, y en internet como alesanabriav. Soy Forward Deployed Engineer en <a href="https://wonderful.ai">Wonderful</a> y vivo en Bogotá, Colombia.</p></div></section>
  <section class="section tint"><div class="shell prose">
    <h2>Trayectoria</h2>
    <p>Llevo en tecnología desde 2012, unos 14 años. Empecé en frontend y de ahí pasé a construir y liderar ingeniería de producto en web y móvil.</p>
    <ul>
      <li><strong>Brand Spa</strong>: Cofundador. Llevé la ingeniería de diciembre de 2012 a octubre de 2017. Productos B2B para clientes: CMS, e-commerce, cotizadores, constructores de sitios y herramientas internas.</li>
      <li><strong>Platzi</strong>: Más de ocho años en móvil, de octubre de 2017 a junio de 2026. Entré como uno de los primeros ingenieros móviles y después lideré iOS y Android, incluida la migración de React Native a Swift y Kotlin nativos. Apple reconoció el trabajo del equipo con Foundation Models y Liquid Glass. También doy cursos en Platzi.</li>
      <li><strong>Wonderful</strong>: Forward Deployed Engineer, de julio de 2026 a hoy. Construyo agentes de IA para los procesos de los clientes y los conecto con las herramientas que ya usan.</li>
    </ul>
    <figure class="about-figure"><img src="/alejandro-sanabria-wwdc26.jpg" srcset="/alejandro-sanabria-wwdc26-800.jpg 800w, /alejandro-sanabria-wwdc26.jpg 1200w" sizes="(max-width: 480px) 100vw, 420px" alt="Alejandro Sanabria en la WWDC26, Apple Park" width="1200" height="1200" loading="lazy" decoding="async" /><figcaption>En la WWDC26, en Apple Park.</figcaption></figure>
    <h2>Lo que he construido</h2>
    <p><a href="/cifro/es/">Cifro</a> es mi app de presupuesto para iPhone, hecha con SwiftUI y Apple Foundation Models. También publico herramientas de código abierto: <a href="/projects/appstore-tools/">appstore-tools</a> (una CLI para App Store Connect), <a href="/projects/screenshots-ios/">screenshots-ios</a> (capturas del simulador de iOS) y <a href="/projects/ios-architect/">ios-architect-skill</a> (skills de arquitectura iOS para Claude Code). Están todas en la <a href="/es/proyectos/">página de proyectos</a>.</p>
    <p>A veces escribo en el <a href="/blog/">blog</a>, por ejemplo sobre <a href="/blog/grok-bot-casos-reales/">los casos reales de mi equipo de bots en Grok Bot</a>.</p>
    <h2>Con qué trabajo</h2>
    <p>Swift, SwiftUI, Kotlin, React Native, TypeScript, y agentes de IA conectados a sistemas que el cliente ya tiene. Automatización de releases en la App Store cuando publico mis propias apps.</p>
    <h2>Dónde encontrarme</h2>
    <ul>{profiles.map((p) => <li><a href={p.href} rel="me noopener noreferrer" target="_blank">{p.label}</a></li>)}</ul>
    <p><a href="/es/">Inicio en español</a> · <a href="/about/" hreflang="en" lang="en">English version</a></p>
  </div></section>
</BaseLayout>
