---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { FULL_NAME, SITE_URL, personId, websiteId } from "../../../data/site";

const pageJsonLd = {
  "@type": "CollectionPage",
  "@id": `${SITE_URL}/es/trabajo/#webpage`,
  url: `${SITE_URL}/es/trabajo/`,
  inLanguage: "es",
  name: `${FULL_NAME}: Brand Spa, Platzi, Wonderful desde 2012`,
  isPartOf: { "@id": websiteId },
  about: { "@id": personId },
  author: { "@id": personId },
};

const work = [
  {
    title: "Brand Spa",
    type: "Cofundador · ingeniero full-stack · dic 2012–oct 2017",
    text: "Productos para empresas B2B: plataformas CMS, e-commerce, cotizadores, constructores de sitios y herramientas internas. Cofundé la agencia y llevé la ingeniería casi cinco años.",
    tags: ["B2B", "Laravel", "Rails", "React"],
  },
  {
    title: "Platzi",
    type: "Lead de iOS y Android · oct 2017–jun 2026",
    text: "Más de ocho años. Entré como uno de los primeros ingenieros móviles y terminé liderando la ingeniería móvil en iOS y Android: Swift y Kotlin nativos, React Native antes, estándares compartidos y crecimiento del equipo. Apple reconoció el trabajo del equipo con Foundation Models y Liquid Glass.",
    tags: ["iOS", "Android", "Swift", "Kotlin"],
  },
  {
    title: "Wonderful",
    type: "Forward Deployed Engineer · jul 2026–hoy",
    text: "Construyo agentes de IA para los clientes de Wonderful y los conecto con las herramientas que ya usan.",
    tags: ["AI agents", "Integrations"],
  },
];
---

<BaseLayout
  title={`${FULL_NAME}: Brand Spa, Platzi, Wonderful desde 2012`}
  description="He trabajado desde 2012: ingeniería en Brand Spa (dic 2012–oct 2017), móvil en Platzi (oct 2017–jun 2026), Forward Deployed Engineer en Wonderful desde julio de 2026."
  lang="es"
  jsonLd={pageJsonLd}
  alternates={[
    { hreflang: "en", href: "/work/" },
    { hreflang: "es", href: "/es/trabajo/" },
    { hreflang: "x-default", href: "/work/" },
  ]}
>
  <section class="page-intro"><div class="shell"><p class="eyebrow">Trabajo · Alejandro Sanabria</p><h1>Dónde he trabajado: Brand Spa, Platzi, Wonderful</h1><p>Soy Forward Deployed Engineer en <a href="https://wonderful.ai">Wonderful</a>. Llevo en tecnología desde 2012, unos 14 años: cofundé Brand Spa y después lideré móvil en Platzi.</p></div></section>
  <section class="section tint"><div class="shell"><div class="card-grid">{work.map((item) => <article class="card"><h2>{item.title}</h2><p class="card-role">{item.type}</p><p>{item.text}</p><ul class="tag-list">{item.tags.map((tag) => <li>{tag}</li>)}</ul></article>)}</div></div></section>
  <section class="section"><div class="shell"><div class="section-heading"><p class="eyebrow">Mi propia app</p><h2>Cifro</h2></div><div class="card-grid"><article class="card featured"><p class="eyebrow">Cifro</p><h3>Una app de presupuesto para iPhone.</h3><p>SwiftUI y Apple Foundation Models, con la IA corriendo en el teléfono. Sin cuenta de Cifro, sin anuncios ni tracking de terceros. La sincronización opcional usa tu cuenta privada de iCloud.</p><a href="/cifro/es/">App de presupuesto Cifro →</a></article></div></div></section>
  <section class="section tint"><div class="shell prose"><h2>Herramientas con las que publico</h2><p><a href="/projects/ios-architect/">Skills de arquitectura iOS para Claude Code</a> mantienen claros los límites de cada feature cuando un agente escribe el código. <a href="/projects/appstore-tools/">appstore-tools</a> maneja la metadata y las subidas a App Store Connect. <a href="/projects/screenshots-ios/">screenshots-ios</a> captura el simulador siempre en el mismo estado.</p><p><a href="/es/proyectos/">Todos los proyectos →</a></p>
  <p><a href="/es/">Inicio en español</a> · <a href="/work/" hreflang="en" lang="en">English version</a></p></div></section>
</BaseLayout>
