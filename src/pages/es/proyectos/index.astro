---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { brandedTitle, topicPageNode } from "../../../data/site";

const title = brandedTitle("Proyectos: Cifro y herramientas");
const description = "Cifro, una app de presupuesto para iPhone, más appstore-tools, screenshots-ios y skills de iOS para agentes de código.";
const pageJsonLd = topicPageNode("/es/proyectos/", title, description, "es");

const projects = [
  {
    title: "Cifro",
    text: "App de presupuesto para iPhone. Gratis, sin anuncios, sin cuenta y sin conectar el banco. Registras gastos escribiendo, con la voz o escaneando un recibo. La hice con SwiftUI y Apple Foundation Models, y la IA corre en el teléfono.",
    links: [
      { href: "/cifro/es/", label: "Página de Cifro" },
      { href: "https://apps.apple.com/app/id6759523370", label: "App Store" },
    ],
  },
  {
    title: "appstore-tools",
    text: "CLI y librería en TypeScript para App Store Connect. Lista tus apps, genera el IPA, lee y actualiza la metadata de la App Store y sube builds.",
    links: [
      { href: "/projects/appstore-tools/", label: "CLI de App Store Connect" },
      { href: "https://github.com/alesanabriav7/appstore-tools", label: "GitHub" },
    ],
  },
  {
    title: "screenshots-ios",
    text: "CLI para capturas del simulador de iOS. Compila la app, ajusta la barra de estado del simulador, la abre en la pantalla que elijas con datos de prueba y guarda la imagen. La configuración vive en un JSON.",
    links: [
      { href: "/projects/screenshots-ios/", label: "CLI de capturas del simulador" },
      { href: "https://github.com/alesanabriav7/screenshots-ios", label: "GitHub" },
    ],
  },
  {
    title: "ios-architect-skill",
    text: "Skills para Claude Code y OpenClaw sobre arquitectura de features en SwiftUI, persistencia con GRDB, tests de concurrencia en Swift y revisiones visuales.",
    links: [
      { href: "/projects/ios-architect/", label: "Skills de arquitectura iOS" },
      { href: "https://github.com/alesanabriav7/ios-architect-skill", label: "GitHub" },
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  lang="es"
  jsonLd={pageJsonLd}
  alternates={[
    { hreflang: "en", href: "/projects/" },
    { hreflang: "es", href: "/es/proyectos/" },
    { hreflang: "x-default", href: "/projects/" },
  ]}
>
  <section class="page-intro"><div class="shell"><p class="eyebrow">Proyectos</p><h1>Cifro y las herramientas con las que publico</h1><p>Una app para iPhone y tres herramientas de código abierto. Las herramientas las uso para construir y publicar la app. La trayectoria laboral está en <a href="/es/sobre-mi/">Sobre mí</a> y en <a href="/es/trabajo/">dónde he trabajado</a>.</p></div></section>
  <section class="section tint"><div class="shell"><div class="card-grid">{projects.map((project) => <article class:list={["card", { featured: project.title === "Cifro" }]}><h2>{project.title}</h2><p>{project.text}</p><p>{project.links.map((link, i) => <>{i > 0 && " · "}<a href={link.href} target={link.href.startsWith("http") ? "_blank" : undefined} rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}>{link.label}</a></>)}</p></article>)}</div>
  <p><a href="/es/sobre-mi/">Sobre mí</a> · <a href="/projects/" hreflang="en" lang="en">English version</a></p></div></section>
</BaseLayout>
