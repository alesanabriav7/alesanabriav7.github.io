---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_NAME, SITE_HANDLE, personId, websiteId, profileLinks, homeAlternates } from "../data/site";
import { posts, postPath } from "../data/posts";
import "../styles/profile.css";

const profileJsonLd = {
  "@type": "ProfilePage",
  "@id": "https://alejandrosanabria.com/#webpage",
  url: "https://alejandrosanabria.com/",
  name: `${SITE_NAME} (${SITE_HANDLE})`,
  isPartOf: { "@id": websiteId },
  mainEntity: { "@id": personId },
  description:
    "Alejandro Sanabria, Forward Deployed Engineer at Wonderful in Bogotá. iOS & Android engineer.",
};
const latestPost = [...posts].sort((a, b) => b.datePublished.localeCompare(a.datePublished))[0];
---

<BaseLayout
  variant="profile"
  title={`${SITE_NAME} | Forward Deployed Engineer in Bogotá`}
  description="I'm Alejandro Sanabria, a Forward Deployed Engineer at Wonderful in Bogotá. I build AI agents for customer workflows and ship iOS apps and developer tools."
  ogType="profile"
  jsonLd={profileJsonLd}
  alternates={homeAlternates}
>
  <div class="page-layout">
    <aside class="sidebar">
      <div class="sidebar-inner">
        <div class="avatar" aria-hidden="true">AS</div>
        <h1 class="sidebar-name">{SITE_NAME}</h1>
        <p class="subtitle">Forward Deployed Engineer at Wonderful · iOS &amp; Android · Bogotá</p>
        <nav class="social-links" aria-label="Social links">
          <a href="https://www.linkedin.com/in/alesanabriav/" target="_blank" rel="me noopener noreferrer">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path></svg>
            LinkedIn
          </a>
          <a href="https://github.com/alesanabriav7" target="_blank" rel="me noopener noreferrer">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"></path></svg>
            GitHub
          </a>
          <a href={profileLinks.x} target="_blank" rel="me noopener noreferrer">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path></svg>
            X (@alesanabriav)
          </a>
          <a href={profileLinks.appStore} target="_blank" rel="me noopener noreferrer">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"></path></svg>
            App Store
          </a>
        </nav>
        <nav class="section-nav" aria-label="On this page">
          <a href="#about">About</a>
          <a href="#work">Selected Work</a>
          <a href="#building">Building Now</a>
                    <a href="#tech">Tech</a>
        </nav>
      </div>
    </aside>

    <div class="profile-content">
      <section id="about" class="profile-section">
        <div class="fade-on-scroll">
          <h2>About</h2>
          <p>I'm Alejandro Sanabria Villescas, a Forward Deployed Engineer at <a href="https://wonderful.ai">Wonderful</a> in Bogotá. I build AI agents and integrations that run on customers' real workflows.</p>
          <p>Before this I spent 8+ years on mobile at Platzi. I joined as one of the first mobile engineers and ended up leading iOS and Android. On the side I ship Cifro, a budget app for iPhone, and small CLI tools for App Store releases.</p>
          <p>More on <a href="/work/">where I've worked</a> and <a href="/projects/">the apps and tools I've built</a>.</p>
          {latestPost && (
            <p class="latest-post"><strong>Latest post:</strong> <a href={postPath(latestPost.slug)} hreflang={latestPost.lang}>{latestPost.title}</a>{latestPost.lang === "es" ? " (in Spanish)" : ""}</p>
          )}
        </div>
      </section>

      <section id="work" class="profile-section">
        <div class="fade-on-scroll">
          <h2>Selected Work</h2>
          <div class="work-grid">
            <article class="work-card">
              <div class="work-card-header"><h3>Wonderful</h3><span class="work-type">forward deployed engineering</span></div>
              <p>I build AI agents for Wonderful's customers and wire them into the systems those customers already use.</p>
              <div class="work-tags"><span>AI agents</span><span>Integrations</span></div>
              <a class="work-link" href="/work/">Where I've worked</a>
            </article>
            <article class="work-card">
              <div class="work-card-header"><h3>iOS skills for coding agents</h3><span class="work-type">open source</span></div>
              <p>Instructions I wrote for Claude Code and OpenClaw so they build SwiftUI features with clear feature boundaries, GRDB for storage, tests, and a visual check at the end.</p>
              <div class="work-tags"><span>Claude Code</span><span>OpenClaw</span><span>SwiftUI</span><span>GRDB</span></div>
              <a class="work-link" href="/projects/ios-architect/">iOS architecture skills for Claude Code</a>
            </article>
            <article class="work-card">
              <div class="work-card-header"><h3>Cifro</h3><span class="work-type">finance app</span></div>
              <p>A free budget app for iPhone. You log an expense by typing "15 lunch", by voice, or by scanning a receipt. No account, no bank login, no ads. The AI runs on the phone with Apple Foundation Models.</p>
              <div class="work-tags"><span>SwiftUI</span><span>Foundation Models</span><span>On-device AI</span><span>Finance</span></div>
              <a class="work-link" href="/cifro/">Cifro budget app</a>
            </article>
            <article class="work-card">
              <div class="work-card-header"><h3>Release tooling</h3><span class="work-type">CLI tools</span></div>
              <p>Two CLIs I use to ship my own apps. appstore-tools uploads builds and edits App Store metadata. screenshots-ios takes the same simulator screenshots every time.</p>
              <div class="work-tags"><span>TypeScript</span><span>App Store Connect</span><span>Simulator</span><span>Automation</span></div>
              <a class="work-link" href="/projects/appstore-tools/">appstore-tools (App Store Connect CLI)</a>
              <a class="work-link" href="/projects/screenshots-ios/">screenshots-ios (simulator screenshots)</a>
            </article>
            <article class="work-card">
              <div class="work-card-header"><h3>Platzi</h3><span class="work-type">iOS &amp; Android lead</span></div>
              <p>8+ years. I joined as one of Platzi's first mobile engineers and ended up leading iOS and Android. We moved the app from React Native to native Swift and Kotlin. Apple recognized the team's Foundation Models and Liquid Glass work.</p>
              <div class="work-tags"><span>iOS</span><span>Android</span><span>Swift</span><span>Kotlin</span><span>React Native</span></div>
            </article>
            <article class="work-card">
              <div class="work-card-header"><h3>Brand Spa</h3><span class="work-type">co-founder · full-stack engineering</span></div>
              <p>I co-founded a digital agency and ran its engineering for almost five years. I was the main engineer on client projects, built with PHP, Laravel, Ruby on Rails, WordPress, React and Node.js.</p>
              <div class="work-tags"><span>B2B</span><span>Full-Stack</span><span>React</span><span>Laravel</span><span>Rails</span></div>
            </article>
            <article class="work-card">
              <div class="work-card-header"><h3>Baubap</h3><span class="work-type">engineering manager</span></div>
              <p>A short stint as engineering manager to get Baubap's first iOS app out on a tight timeline.</p>
              <div class="work-tags"><span>iOS</span><span>Engineering Management</span></div>
            </article>
          </div>
        </div>
      </section>

      <section id="building" class="profile-section">
        <div class="fade-on-scroll">
          <h2>What I'm Building Now</h2>
          <p>Agents at Wonderful, updates to <a href="/cifro/">Cifro</a>, and the release tools I use for it: <a href="/projects/appstore-tools/">appstore-tools</a> and <a href="/projects/screenshots-ios/">screenshots-ios</a>.</p>
          <p>I still read the code. If I can't judge a trade-off, I shouldn't be the one approving it.</p>
        </div>
      </section>

      <section id="tech" class="profile-section">
        <div class="fade-on-scroll">
          <h2>Tech</h2>
          <div class="tech-row">
            <span class="tech-badge">Swift</span><span class="tech-badge">SwiftUI</span><span class="tech-badge">iOS</span><span class="tech-badge">Kotlin</span><span class="tech-badge">Android</span><span class="tech-badge">React Native</span><span class="tech-badge">TypeScript</span><span class="tech-badge">React</span><span class="tech-badge">Node.js</span><span class="tech-badge">Laravel</span><span class="tech-badge">Ruby on Rails</span><span class="tech-badge">Tuist</span><span class="tech-badge">GRDB</span><span class="tech-badge">Claude Code</span><span class="tech-badge">OpenClaw</span><span class="tech-badge">Foundation Models</span><span class="tech-badge">Git</span>
          </div>
        </div>
      </section>

      <footer class="profile-footer">
        <nav class="site-links" aria-label="Site links"><a href="/work/">Work</a><a href="/projects/">Projects</a><a href="/cifro/">Cifro</a><a href="/blog/" hreflang="es">Blog</a><a href="/about/">About</a><a href="/es/" hreflang="es" lang="es">Español</a></nav>
        <nav class="social-links" aria-label="Social links"><a href="https://www.linkedin.com/in/alesanabriav/" target="_blank" rel="me noopener noreferrer">LinkedIn</a><a href="https://github.com/alesanabriav7" target="_blank" rel="me noopener noreferrer">GitHub</a><a href={profileLinks.x} target="_blank" rel="me noopener noreferrer">X</a><a href={profileLinks.appStore} target="_blank" rel="me noopener noreferrer">App Store</a><a href={profileLinks.platzi} target="_blank" rel="me noopener noreferrer">Platzi</a></nav>
        <p class="copyright">© {new Date().getFullYear()} {SITE_NAME}</p>
      </footer>
    </div>
  </div>

  <script>
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const fadeElements = document.querySelectorAll<HTMLElement>(".fade-on-scroll");

    if (!reducedMotion) {
      document.body.classList.add("motion-ready");
      const fadeObserver = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("visible");
            fadeObserver.unobserve(entry.target);
          }
        }
      }, { threshold: 0.15 });

      for (const element of fadeElements) {
        const rect = element.getBoundingClientRect();
        if (rect.top < window.innerHeight && rect.bottom > 0) element.classList.add("visible");
        else fadeObserver.observe(element);
      }
    }

    const navLinks = [...document.querySelectorAll<HTMLAnchorElement>(".section-nav a")];
    const sections = [...document.querySelectorAll<HTMLElement>(".profile-section[id]")];
    let lockedSectionId: string | null = null;

    const setActiveSection = (id: string) => {
      for (const link of navLinks) {
        const active = link.hash === `#${id}`;
        link.classList.toggle("active", active);
        if (active) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      }
    };

    const updateActiveSection = () => {
      if (lockedSectionId) return;
      if (window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2) {
        setActiveSection(sections.at(-1)?.id ?? "about");
        return;
      }

      const threshold = window.innerHeight * 0.35;
      let activeSection = sections[0];
      for (const section of sections) {
        if (section.getBoundingClientRect().top > threshold) break;
        activeSection = section;
      }
      setActiveSection(activeSection?.id ?? "about");
    };

    let scrollUpdatePending = false;
    const scheduleActiveSectionUpdate = () => {
      if (scrollUpdatePending) return;
      scrollUpdatePending = true;
      requestAnimationFrame(() => {
        updateActiveSection();
        scrollUpdatePending = false;
      });
    };

    const syncHashOrScroll = () => {
      const hashSection = sections.find((section) => `#${section.id}` === window.location.hash);
      lockedSectionId = hashSection?.id ?? null;
      if (lockedSectionId) setActiveSection(lockedSectionId);
      else updateActiveSection();
    };

    const releaseNavigationLock = () => {
      if (!lockedSectionId) return;
      lockedSectionId = null;
      scheduleActiveSectionUpdate();
    };

    for (const link of navLinks) {
      link.addEventListener("click", () => {
        lockedSectionId = link.hash.slice(1);
        setActiveSection(lockedSectionId);
      });
    }

    window.addEventListener("scroll", scheduleActiveSectionUpdate, { passive: true });
    window.addEventListener("resize", scheduleActiveSectionUpdate);
    window.addEventListener("hashchange", syncHashOrScroll);
    window.addEventListener("wheel", releaseNavigationLock, { passive: true });
    window.addEventListener("touchstart", releaseNavigationLock, { passive: true });
    window.addEventListener("pointerdown", releaseNavigationLock, { passive: true });
    window.addEventListener("keydown", (event) => {
      if (["ArrowUp", "ArrowDown", "PageUp", "PageDown", "Home", "End", " "].includes(event.key)) {
        releaseNavigationLock();
      }
    });
    syncHashOrScroll();
  </script>
</BaseLayout>
