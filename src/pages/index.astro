---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_NAME, SITE_HANDLE, personId, websiteId } from "../data/site";
import "../styles/profile.css";

const profileJsonLd = {
  "@type": "ProfilePage",
  "@id": "https://alejandrosanabria.com/#webpage",
  url: "https://alejandrosanabria.com/",
  name: `${SITE_NAME} — ${SITE_HANDLE}`,
  isPartOf: { "@id": websiteId },
  mainEntity: { "@id": personId },
  description:
    "Forward Deployed Engineer at Wonderful.ai, building AI agents and integrations for customer workflows.",
};
---

<BaseLayout
  variant="profile"
  title={`${SITE_NAME} | Forward Deployed Engineer & AI`}
  description="Alejandro Sanabria builds AI agents and integrations as a Forward Deployed Engineer at Wonderful.ai. Explore his public products and developer tools."
  ogType="profile"
  jsonLd={profileJsonLd}
>
  <div class="page-layout">
    <aside class="sidebar">
      <div class="sidebar-inner">
        <div class="avatar" aria-hidden="true">AS</div>
        <h1 class="sidebar-name">{SITE_NAME}</h1>
        <p class="subtitle">Forward Deployed Engineer at Wonderful.ai · AI agents & integrations</p>
        <nav class="social-links" aria-label="Social links">
          <a href="https://www.linkedin.com/in/alesanabriav/" target="_blank" rel="me noopener noreferrer">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path></svg>
            LinkedIn
          </a>
          <a href="https://github.com/alesanabriav7" target="_blank" rel="me noopener noreferrer">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"></path></svg>
            GitHub
          </a>
        </nav>
        <nav class="section-nav" aria-label="On this page">
          <a href="#about">About</a>
          <a href="#work">Selected Work</a>
          <a href="#building">Building Now</a>
          <a href="#beliefs">Beliefs</a>
          <a href="#tech">Tech</a>
        </nav>
      </div>
    </aside>

    <div class="profile-content">
      <section id="about" class="profile-section">
        <div class="fade-on-scroll">
          <h2>About</h2>
          <p>I'm Alejandro Sanabria, a Forward Deployed Engineer at <a href="https://wonderful.ai">Wonderful.ai</a>. I build AI agents and integrations for real customer workflows.</p>
          <p>My work connects customer needs, product decisions, implementation, and verification. A background in mobile platforms and full-stack products helps me carry those decisions into working software.</p>
          <p>Explore my <a href="/work/">forward deployed engineering work</a> and <a href="/projects/">public apps and developer tools</a>.</p>
        </div>
      </section>

      <section id="work" class="profile-section">
        <div class="fade-on-scroll">
          <h2>Selected Work</h2>
          <div class="work-grid">
            <article class="work-card">
              <div class="work-card-header"><h3>Wonderful.ai</h3><span class="work-type">forward deployed engineering</span></div>
              <p>I build AI agents and integrations around customer workflows, connecting product constraints with implementation and verification.</p>
              <div class="work-tags"><span>FDE</span><span>AI Workflows</span><span>Customer Context</span><span>Implementation</span></div>
              <a class="work-link" href="/work/">Explore my engineering work</a>
            </article>
            <article class="work-card">
              <div class="work-card-header"><h3>iOS Workflow Systems</h3><span class="work-type">workflow tooling</span></div>
              <p>Reusable workflow patterns for iOS architecture, implementation planning, code review, validation, App Store operations, and screenshot generation. The workflows make architecture decisions, review, and verification explicit.</p>
              <div class="work-tags"><span>Claude Code</span><span>OpenClaw</span><span>Skills</span><span>AI workflows</span></div>
              <a class="work-link" href="/projects/ios-architect/">ios-architect-skill</a>
            </article>
            <article class="work-card">
              <div class="work-card-header"><h3>Cifro</h3><span class="work-type">finance app</span></div>
              <p>A published private-by-design iOS finance app built with SwiftUI and Apple Foundation Models. Cifro uses on-device AI for transaction parsing, budget bucket suggestions, daily insights, and a review ritual — no Cifro account, no ads or third-party tracking, and optional sync through your private iCloud account.</p>
              <div class="work-tags"><span>SwiftUI</span><span>Foundation Models</span><span>On-device AI</span><span>Finance</span></div>
              <a class="work-link" href="/cifro/">Explore Cifro</a>
            </article>
            <article class="work-card">
              <div class="work-card-header"><h3>Release &amp; Screenshot Automation</h3><span class="work-type">iOS automation</span></div>
              <p>Command-line tooling that supports the mobile delivery workflow: App Store Connect metadata and build upload automation, plus deterministic iOS simulator screenshot capture for App Store assets, regression checks, and CI pipelines.</p>
              <div class="work-tags"><span>TypeScript</span><span>App Store Connect</span><span>Simulator</span><span>Automation</span></div>
              <a class="work-link" href="/projects/appstore-tools/">appstore-tools</a>
              <a class="work-link" href="/projects/screenshots-ios/">screenshots-ios</a>
            </article>
            <article class="work-card">
              <div class="work-card-header"><h3>Platzi Mobile Platform</h3><span class="work-type">mobile platform leadership</span></div>
              <p>8+ year mobile chapter growing from one of Platzi's first mobile engineers into leading iOS and Android platform work. Helped move the platform from React Native to native Swift and Kotlin, scale shared standards, and build the team behind Apple-recognized Foundation Models and Liquid Glass work.</p>
              <div class="work-tags"><span>iOS</span><span>Android</span><span>Swift</span><span>Kotlin</span><span>React Native</span></div>
            </article>
            <article class="work-card">
              <div class="work-card-header"><h3>Brand Spa</h3><span class="work-type">co-founder · full-stack engineering</span></div>
              <p>Co-founded and led the engineering side of a digital agency for nearly five years, serving as the principal engineer across client projects. Built custom web solutions from architecture to production using PHP, Laravel, Ruby on Rails, WordPress, React, and Node.js.</p>
              <div class="work-tags"><span>B2B Products</span><span>Full-Stack</span><span>React</span><span>Laravel</span><span>Rails</span></div>
            </article>
            <article class="work-card">
              <div class="work-card-header"><h3>Baubap iOS First Version</h3><span class="work-type">short engineering management chapter</span></div>
              <p>A short engineering management chapter focused on getting Baubap's first iOS version moving quickly: aligning product, mobile architecture, delivery constraints, and team execution around a compressed timeline.</p>
              <div class="work-tags"><span>iOS</span><span>Engineering Management</span><span>Delivery</span><span>Product Alignment</span></div>
            </article>
          </div>
        </div>
      </section>

      <section id="building" class="profile-section">
        <div class="fade-on-scroll">
          <h2>What I'm Building Now</h2>
          <p>I'm applying AI to the parts of engineering where context, review, and repetition usually slow teams down.</p>
          <p>The work is practical: tools and workflows I use to plan, build, verify, package, and release real software.</p>
          <div class="building-grid">
            <div class="building-item"><span class="label">FDE work</span><span class="desc">Working close to customer workflows, product needs, AI systems, and implementation</span></div>
            <div class="building-item"><span class="label">Architecture workflows</span><span class="desc">Breaking down ambiguous work into implementation plans and trade-offs</span></div>
            <div class="building-item"><span class="label">Review loops</span><span class="desc">Using AI to preserve context, check assumptions, and verify output</span></div>
            <div class="building-item"><span class="label">Delivery tooling</span><span class="desc">Automating screenshots, App Store work, and release steps</span></div>
            <div class="building-item"><span class="label">Product systems</span><span class="desc">Building apps like Cifro where AI supports useful product behavior</span></div>
          </div>
          <p>The goal is not AI for its own sake. The goal is better engineering judgment, faster feedback, and working systems.</p>
        </div>
      </section>

      <section id="beliefs" class="profile-section">
        <div class="fade-on-scroll">
          <h2>What I Believe</h2>
          <ul class="beliefs-list">
            <li><strong>Quality is a multiplier, not a tax.</strong> Investing in architecture pays back in velocity every sprint.</li>
            <li><strong>Lead from the code, not above it.</strong> An EM who can't evaluate a technical trade-off is managing blind.</li>
            <li><strong>AI becomes useful when it lands inside a workflow.</strong> The hard part is connecting model behavior to a real job, team, and outcome.</li>
            <li><strong>AI should augment judgment, not replace it.</strong> The goal is better engineering, not just faster output.</li>
          </ul>
        </div>
      </section>

      <section id="tech" class="profile-section">
        <div class="fade-on-scroll">
          <h2>Tech</h2>
          <div class="tech-row">
            <span class="tech-badge">Swift</span><span class="tech-badge">SwiftUI</span><span class="tech-badge">iOS</span><span class="tech-badge">Kotlin</span><span class="tech-badge">Android</span><span class="tech-badge">React Native</span><span class="tech-badge">TypeScript</span><span class="tech-badge">React</span><span class="tech-badge">Node.js</span><span class="tech-badge">Laravel</span><span class="tech-badge">Ruby on Rails</span><span class="tech-badge">Tuist</span><span class="tech-badge">GRDB</span><span class="tech-badge">Claude Code</span><span class="tech-badge">OpenClaw</span><span class="tech-badge">Foundation Models</span><span class="tech-badge">Forward Deployed Engineering</span><span class="tech-badge">AI Workflows</span><span class="tech-badge">Product Engineering</span><span class="tech-badge">Git</span>
          </div>
        </div>
      </section>

      <footer class="profile-footer">
        <nav class="site-links" aria-label="Site links"><a href="/work/">Work</a><a href="/projects/">Projects</a><a href="/cifro/">Cifro</a></nav>
        <nav class="social-links" aria-label="Social links"><a href="https://www.linkedin.com/in/alesanabriav/" target="_blank" rel="me noopener noreferrer">LinkedIn</a><a href="https://github.com/alesanabriav7" target="_blank" rel="me noopener noreferrer">GitHub</a></nav>
        <p class="copyright">© {new Date().getFullYear()} {SITE_NAME}</p>
      </footer>
    </div>
  </div>

  <script>
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const fadeElements = document.querySelectorAll<HTMLElement>(".fade-on-scroll");

    if (!reducedMotion) {
      document.body.classList.add("motion-ready");
      const fadeObserver = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("visible");
            fadeObserver.unobserve(entry.target);
          }
        }
      }, { threshold: 0.15 });

      for (const element of fadeElements) {
        const rect = element.getBoundingClientRect();
        if (rect.top < window.innerHeight && rect.bottom > 0) element.classList.add("visible");
        else fadeObserver.observe(element);
      }
    }

    const navLinks = [...document.querySelectorAll<HTMLAnchorElement>(".section-nav a")];
    const sections = [...document.querySelectorAll<HTMLElement>(".profile-section[id]")];
    let lockedSectionId: string | null = null;

    const setActiveSection = (id: string) => {
      for (const link of navLinks) {
        const active = link.hash === `#${id}`;
        link.classList.toggle("active", active);
        if (active) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      }
    };

    const updateActiveSection = () => {
      if (lockedSectionId) return;
      if (window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2) {
        setActiveSection(sections.at(-1)?.id ?? "about");
        return;
      }

      const threshold = window.innerHeight * 0.35;
      let activeSection = sections[0];
      for (const section of sections) {
        if (section.getBoundingClientRect().top > threshold) break;
        activeSection = section;
      }
      setActiveSection(activeSection?.id ?? "about");
    };

    let scrollUpdatePending = false;
    const scheduleActiveSectionUpdate = () => {
      if (scrollUpdatePending) return;
      scrollUpdatePending = true;
      requestAnimationFrame(() => {
        updateActiveSection();
        scrollUpdatePending = false;
      });
    };

    const syncHashOrScroll = () => {
      const hashSection = sections.find((section) => `#${section.id}` === window.location.hash);
      lockedSectionId = hashSection?.id ?? null;
      if (lockedSectionId) setActiveSection(lockedSectionId);
      else updateActiveSection();
    };

    const releaseNavigationLock = () => {
      if (!lockedSectionId) return;
      lockedSectionId = null;
      scheduleActiveSectionUpdate();
    };

    for (const link of navLinks) {
      link.addEventListener("click", () => {
        lockedSectionId = link.hash.slice(1);
        setActiveSection(lockedSectionId);
      });
    }

    window.addEventListener("scroll", scheduleActiveSectionUpdate, { passive: true });
    window.addEventListener("resize", scheduleActiveSectionUpdate);
    window.addEventListener("hashchange", syncHashOrScroll);
    window.addEventListener("wheel", releaseNavigationLock, { passive: true });
    window.addEventListener("touchstart", releaseNavigationLock, { passive: true });
    window.addEventListener("pointerdown", releaseNavigationLock, { passive: true });
    window.addEventListener("keydown", (event) => {
      if (["ArrowUp", "ArrowDown", "PageUp", "PageDown", "Home", "End", " "].includes(event.key)) {
        releaseNavigationLock();
      }
    });
    syncHashOrScroll();
  </script>
</BaseLayout>
