---
import "../styles/home.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";
import Card from "../components/ui/Card.astro";
import InsetList from "../components/ui/InsetList.astro";
import Section from "../components/ui/Section.astro";
import StatGrid from "../components/ui/StatGrid.astro";
import { SITE_NAME, SITE_URL, personId, personSameAs, websiteId } from "../data/site";
import { experience } from "../data/experience";
import { cifroAppStoreUrl } from "../data/cifro";
import { contactEmail } from "../data/navigation";
import { getPosts } from "../data/writing";
import PostList from "../components/ui/PostList.astro";

const latestPosts = (await getPosts()).slice(0, 3);

const description =
  "Alejandro Sanabria is a Forward Deployed Engineer at Wonderful.ai with 12+ years building software products — native iOS and Android at the core, plus full-stack web, B2B platforms, and AI agents.";

const profileJsonLd = {
  "@type": "ProfilePage",
  "@id": `${SITE_URL}/#webpage`,
  url: `${SITE_URL}/`,
  name: `${SITE_NAME} — Forward Deployed Engineer`,
  isPartOf: { "@id": websiteId },
  mainEntity: { "@id": personId },
  about: { "@id": personId },
  description,
};

const stats = [
  { value: "12+ years", label: "Building and shipping software products" },
  { value: "iOS & Android", label: "Mobile at the core — Swift, SwiftUI, Kotlin" },
  { value: "Full-stack", label: "Web, backend and B2B platforms" },
  { value: "AI agents", label: "In production at Wonderful.ai" },
];

const projects = [
  {
    title: "Cifro",
    meta: "iOS app · App Store",
    icon: { src: "/cifro/icon.jpg", alt: "Cifro app icon" },
    text: "A private-by-design budget planner built with SwiftUI and Apple Foundation Models. On-device AI parses transactions, suggests budgets, and surfaces daily insights — no account, no ads, no tracking.",
    links: [{ href: "/cifro/", label: "Explore Cifro" }, { href: cifroAppStoreUrl, label: "App Store", external: true }],
  },
  {
    title: "iOS Architecture Skills",
    meta: "AI coding workflow",
    glyph: "layers" as const,
    tint: "indigo" as const,
    text: "Architecture, persistence, testing, and visual-check workflows that help AI coding agents build SwiftUI features with clear boundaries and verification.",
    links: [{ href: "/projects/ios-architect/", label: "Learn more" }],
  },
  {
    title: "App Store Tools",
    meta: "TypeScript CLI",
    glyph: "terminal" as const,
    tint: "gray" as const,
    text: "App Store Connect automation from the command line: list apps, prepare IPAs, review metadata, and upload builds.",
    links: [{ href: "/projects/appstore-tools/", label: "Learn more" }],
  },
  {
    title: "Screenshots iOS",
    meta: "Simulator automation",
    glyph: "viewfinder" as const,
    tint: "pink" as const,
    text: "Deterministic iOS simulator screenshots with repeatable app state for App Store assets, visual regression checks, and CI.",
    links: [{ href: "/projects/screenshots-ios/", label: "Learn more" }],
  },
];

const capabilities = [
  { title: "Mobile platforms", items: ["Swift & SwiftUI", "Kotlin & Android", "React Native", "GRDB & Tuist", "Apple Foundation Models", "App Store Connect automation"] },
  { title: "AI & forward deployment", items: ["AI agents & integrations", "Customer workflow design", "Evaluation & verification", "Claude Code & OpenClaw", "Agent skills & tooling"] },
  { title: "Product & full-stack", items: ["Product discovery to delivery", "TypeScript, Node.js & React", "Laravel & Ruby on Rails", "B2B platforms & e-commerce", "Engineering leadership"] },
];

const principles = [
  { title: "Quality is a multiplier, not a tax.", text: "Investing in architecture pays back in velocity every sprint." },
  { title: "Lead from the code, not above it.", text: "If you can't evaluate a technical trade-off, you're managing blind." },
  { title: "AI is useful once it lands in a workflow.", text: "The hard part is connecting model behavior to a real job, team, and outcome." },
  { title: "Augment judgment, don't replace it.", text: "The goal is better engineering, not just faster output." },
];
---

<BaseLayout
  title={`${SITE_NAME} | Forward Deployed Engineer & Product Engineer`}
  description={description}
  ogType="profile"
  jsonLd={profileJsonLd}
>
  <section class="hero">
    <div class="container">
      <p class="hero__eyebrow enter" style="--i: 0">Forward Deployed Engineer at Wonderful.ai</p>
      <h1 class="enter" style="--i: 1">{SITE_NAME}</h1>
      <p class="hero__lead enter" style="--i: 2">I bring <strong>AI agents into real customer workflows</strong> — backed by 12+ years building software products, with native mobile at the core.</p>
      <div class="btn-row enter" style="--i: 3">
        <Button href="/work/">See my work</Button>
        <a class="text-link" href={personSameAs[0]} target="_blank" rel="me noopener noreferrer">Connect on LinkedIn</a>
      </div>
    </div>
    <figure class="hero__media container">
      <div class="hero__frame">
        <img
          src="/images/wwdc26-1600.webp"
          srcset="/images/wwdc26-900.webp 900w, /images/wwdc26-1600.webp 1600w"
          sizes="(max-width: 800px) calc(100vw - 44px), 760px"
          alt="Alejandro Sanabria at WWDC 2026 in Apple Park, holding his WWDC26 attendee badge"
          width="1600"
          height="1067"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <figcaption>WWDC 2026 · Apple Park</figcaption>
    </figure>
  </section>

  <section class="hero-stats">
    <div class="container"><StatGrid items={stats} /></div>
  </section>

  <Section id="about" title="About." kicker="Customer context in, working software out.">
    <div class="about">
      <div class="about-copy">
        <p>I'm a Forward Deployed Engineer at <a href="https://wonderful.ai">Wonderful.ai</a>. I sit between customers and the product: understanding the workflow, building the agents and integrations, and verifying they hold up in production.</p>
        <p>That work rests on <strong>12+ years building software products</strong>. Mobile is the core — shipping native iOS and Android apps and leading platform teams — alongside full-stack web products, B2B platforms, and the delivery systems behind them.</p>
        <p>Today I apply AI where context, review, and repetition slow teams down: architecture planning, review loops, and release tooling.</p>
      </div>
      <figure class="about__portrait">
        <img
          src="/images/apple-park-portrait-1000.webp"
          srcset="/images/apple-park-portrait-600.webp 600w, /images/apple-park-portrait-1000.webp 1000w"
          sizes="(max-width: 800px) calc(100vw - 44px), 320px"
          alt="Portrait of Alejandro Sanabria at Apple Park"
          width="1000"
          height="1000"
          loading="lazy"
          decoding="async"
        />
        <figcaption>Apple Park, Cupertino</figcaption>
      </figure>
    </div>
  </Section>

  <Section id="experience" title="Experience." kicker="Products, platforms, and AI in production.">
    <InsetList items={experience} />
    <div class="btn-row"><a class="text-link" href="/work/">Full work history</a></div>
  </Section>

  <Section id="projects" title="Projects." kicker="Shipped apps and the tools behind them.">
    <div class="card-grid card-grid--2">
      {projects.map((project) => (
        <Card title={project.title} meta={project.meta} icon={project.icon} glyph={project.glyph} glyphColor={project.tint} links={project.links}>
          <p>{project.text}</p>
        </Card>
      ))}
    </div>
  </Section>

  <Section id="capabilities" title="Capabilities." kicker="Mobile at the core, product end to end.">
    <div class="card-grid card-grid--3">
      {capabilities.map((group) => (
        <Card title={group.title}>
          <ul class="plain-list">{group.items.map((item) => <li>{item}</li>)}</ul>
        </Card>
      ))}
    </div>
  </Section>

  <Section id="principles" title="Principles." kicker="How I like to work.">
    <div class="card-grid card-grid--2">
      {principles.map((principle) => (
        <Card title={principle.title}><p>{principle.text}</p></Card>
      ))}
    </div>
  </Section>

  {latestPosts.length > 0 && (
    <Section id="writing" title="Writing." kicker="What I'm learning in the field.">
      <PostList posts={latestPosts} />
      <div class="btn-row"><a class="text-link" href="/writing/">All writing</a></div>
    </Section>
  )}

  <Section id="contact" title="Contact." kicker="Let's build something that holds up.">
    <div class="contact">
      <p>I'm always up for a conversation about AI in production, mobile platforms, or a product that needs to ship. The best way to reach me is LinkedIn or email.</p>
      <div class="btn-row">
        <Button href={personSameAs[0]} external>Connect on LinkedIn</Button>
        <a class="text-link" href={`mailto:${contactEmail}`}>{contactEmail}</a>
      </div>
    </div>
  </Section>
</BaseLayout>
