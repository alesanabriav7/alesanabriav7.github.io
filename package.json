{
  "name": "alesanabriav-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/build-markdown.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "check:markdown": "node scripts/check-markdown.mjs",
    "submit:indexnow": "node scripts/submit-indexnow.mjs",
    "check:lint": "oxlint --deny curly --deny-warnings src/data/*.ts src/pages/*.ts src/components/ui/types.ts",
    "check:types": "tsc --noEmit -p tsconfig.json",
    "check:unused": "knip --no-progress"
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "knip": "6.44.2",
    "linkedom": "0.18.15",
    "oxlint": "1.92.0",
    "turndown": "7.2.5",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "packageExtensions": {
      "@astrojs/astro2tsx@0.1.3": {
        "dependencies": {
          "@emnapi/runtime": "1.11.3"
        }
      }
    }
  }
}
